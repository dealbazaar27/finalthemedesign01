{%- doc -%}
  @param [limit] - {number}

  The maximum number of items to display. Anything above shows as "99+".

  Colors: reads --cart-bubble-background / --cart-bubble-text from an ancestor. Falls back to a contrasting pair
  computed from the palette foreground when unset.
{%- enddoc -%}

{% liquid
  assign bubble_bg_fallback = settings.page_text_color
  assign bubble_text_fallback = settings.page_background_color
%}

<div
  ref="cartBubble"
  class="cart-bubble{% if cart == empty or cart.item_count == 0 %} visually-hidden{% endif %}"
  style="--cart-bubble-background-fallback: {{ bubble_bg_fallback }}; --cart-bubble-text-fallback: {{ bubble_text_fallback }};"
  {% assign item_count = cart.item_count %}
  {% if item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>
  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
  >
    <span
      class="cart-bubble__text-count{% if cart == empty or cart.item_count == 0 %} hidden{% endif %}"
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if limit == blank or cart.item_count < limit %}
        {{- cart.item_count -}}
      {%- else -%}
        99+
      {%- endif -%}
    </span>
  </span>
</div>

{% stylesheet %}
  .cart-bubble {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border-width: 0;
    display: flex;
    line-height: 1;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    padding: 0;
    top: 2px;
    right: -4px;
    z-index: 10;
  }

  .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
  }

  .cart-bubble__background {
    position: absolute;
    inset: 0;
    background-color: #d8232a;
    border-radius: 50%;
    z-index: 1;
  }

  .cart-bubble__text {
    font-size: 10px;
    font-weight: 800;
    z-index: 2;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .cart-bubble__text-count {
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
  }
{% endstylesheet %}
