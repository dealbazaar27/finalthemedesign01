{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div class="cart-items__wrapper cart-items__wrapper--drawer-empty" data-cart-drawer-empty>
      {% render 'boat-empty-cart', is_drawer: true %}
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'content.cart_title' | t %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              {% liquid
                assign total_compare_price = 0
                for item in cart.items
                  if item.variant.compare_at_price > item.variant.price
                    assign item_comp = item.variant.compare_at_price | times: item.quantity
                    assign total_compare_price = total_compare_price | plus: item_comp
                  else
                    assign item_orig = item.original_line_price
                    assign total_compare_price = total_compare_price | plus: item_orig
                  endif
                endfor

                # Tier quantity deals: 2+ items = 6%, 5+ items = 7%, 10+ items = 10%
                assign total_cart_qty = 0
                for item in cart.items
                  assign total_cart_qty = total_cart_qty | plus: item.quantity
                endfor

                assign auto_tier_pct = 0
                if total_cart_qty >= 10
                  assign auto_tier_pct = 10
                elsif total_cart_qty >= 5
                  assign auto_tier_pct = 7
                elsif total_cart_qty >= 2
                  assign auto_tier_pct = 6
                endif

                assign tier_savings_cents = 0
                if auto_tier_pct > 0
                  assign tier_savings_cents = cart.items_subtotal_price | times: auto_tier_pct | divided_by: 100
                endif

                assign effective_cart_total = cart.total_price
                if cart.total_discount == 0 and tier_savings_cents > 0
                  assign effective_cart_total = cart.total_price | minus: tier_savings_cents
                endif

                assign total_savings = 0
                if total_compare_price > effective_cart_total
                  assign total_savings = total_compare_price | minus: effective_cart_total
                endif
              %}

              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 60px;"
              >
                {% comment %} --- Savings Banner --- {% endcomment %}
                {% if total_savings > 0 %}
                  <div class="boat-cart-savings-banner">
                    <span class="boat-savings-icon">🔥</span>
                    <span class="boat-savings-text">Total Savings on this order: <strong>{{ total_savings | money_without_trailing_zeros }}</strong></span>
                  </div>
                {% endif %}

                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section', total_savings: total_savings, total_compare_price: total_compare_price %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}

  <script>
    (function () {
      function syncCartScrollLock() {
        var cartDrawer = document.getElementById('cart-drawer');
        var dialog = cartDrawer ? cartDrawer.querySelector('dialog') : null;
        var isOpen = Boolean(cartDrawer && (cartDrawer.hasAttribute('open') || (dialog && dialog.hasAttribute('open'))));
        
        if (isOpen) {
          document.documentElement.classList.add('cart-drawer-open');
          document.body.classList.add('cart-drawer-open');
          document.documentElement.style.overflow = 'hidden';
          document.body.style.overflow = 'hidden';
        } else {
          document.documentElement.classList.remove('cart-drawer-open');
          document.body.classList.remove('cart-drawer-open');
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
        }
      }

      document.addEventListener('theme-drawer:open', function (e) {
        if (!e.target || e.target.id === 'cart-drawer' || e.target.closest('#cart-drawer')) {
          syncCartScrollLock();
        }
      });

      document.addEventListener('theme-drawer:close', function () {
        setTimeout(syncCartScrollLock, 50);
      });

      var obs = new MutationObserver(syncCartScrollLock);
      function bindCartObserver() {
        var cartDrawer = document.getElementById('cart-drawer');
        if (cartDrawer) {
          obs.observe(cartDrawer, { attributes: true, attributeFilter: ['open'] });
          var dialog = cartDrawer.querySelector('dialog');
          if (dialog) {
            obs.observe(dialog, { attributes: true, attributeFilter: ['open'] });
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindCartObserver);
      } else {
        bindCartObserver();
      }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* ── Strict Background Scroll Lock when Cart Drawer is Open ── */
  html:has(#cart-drawer[open]),
  body:has(#cart-drawer[open]),
  html.cart-drawer-open,
  body.cart-drawer-open {
    overflow: hidden !important;
    overscroll-behavior: none !important;
    touch-action: none !important;
  }

  html:has(#cart-drawer[open]) .page-wrapper,
  html.cart-drawer-open .page-wrapper {
    overflow: hidden !important;
  }

  #cart-drawer dialog,
  #cart-drawer .cart-drawer__inner {
    overscroll-behavior: contain !important;
  }

  cart-drawer-component {
    --cart-drawer-padding: 16px;
    --font-paragraph--line-height: 1;
    display: contents;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #f8fafc !important;
  }

  .theme-drawer__header {
    padding: 14px 18px !important;
    border-bottom: 1px solid #e2e8f0 !important;
    background: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
  }

  .theme-drawer__title {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    letter-spacing: -0.3px !important;
  }

  .theme-drawer__badge {
    background: #d8232a !important;
    color: #ffffff !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
    padding: 2px 7px !important;
    border-radius: 12px !important;
    margin-left: 6px !important;
  }

  .theme-drawer__close-button {
    background: #f1f5f9 !important;
    border-radius: 50% !important;
    width: 32px !important;
    height: 32px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid #e2e8f0 !important;
    cursor: pointer !important;
    transition: background 0.15s ease !important;
  }

  .theme-drawer__close-button:hover {
    background: #e2e8f0 !important;
  }

  .boat-cart-shipping-bar {
    background: #ecfdf5 !important;
    border-bottom: 1px solid #a7f3d0 !important;
    padding: 10px 14px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }

  .boat-cart-shipping-text {
    font-size: 0.78rem !important;
    font-weight: 700 !important;
    color: #065f46 !important;
    text-align: center !important;
    line-height: 1.3 !important;
  }

  .boat-cart-shipping-text.unlocked {
    color: #047857 !important;
  }

  .boat-cart-progress-track {
    width: 100% !important;
    height: 7px !important;
    background: #d1fae5 !important;
    border-radius: 10px !important;
    overflow: hidden !important;
  }

  .boat-cart-progress-fill {
    height: 100% !important;
    background: #10b981 !important;
    border-radius: 10px !important;
    transition: width 0.4s ease !important;
  }

  .boat-cart-progress-fill.unlocked {
    background: linear-gradient(90deg, #10b981, #059669) !important;
  }

  .boat-cart-savings-banner {
    background: #fefce8 !important;
    border-bottom: 1px solid #fef08a !important;
    padding: 8px 14px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    font-size: 0.76rem !important;
    font-weight: 700 !important;
    color: #854d0e !important;
  }

  /* --- Collapsible Bill Breakdown Card (SS 3) --- */
  .boat-bill-card {
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 12px !important;
    padding: 10px 14px 10px 14px !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
    margin-top: 4px !important;
    width: 100% !important;
    box-sizing: border-box !important;
    transition: all 0.25s ease !important;
  }

  .boat-bill-collapse-body {
    display: grid !important;
    grid-template-rows: 0fr !important;
    opacity: 0 !important;
    margin: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    pointer-events: none !important;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, margin 0.25s ease !important;
  }

  .boat-bill-card.is-open .boat-bill-collapse-body,
  .boat-bill-collapse-body.is-open {
    grid-template-rows: 1fr !important;
    opacity: 1 !important;
    margin-bottom: 8px !important;
    pointer-events: auto !important;
  }

  .boat-bill-collapse-inner {
    overflow: hidden !important;
    min-height: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }

  .boat-bill-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    font-size: 0.84rem !important;
    font-weight: 700 !important;
    color: #1e293b !important;
    line-height: 1.3 !important;
  }

  .boat-bill-label {
    color: #334155 !important;
    font-weight: 700 !important;
  }

  .boat-bill-value {
    color: #0f172a !important;
    font-weight: 800 !important;
  }

  .boat-bill-value.text-green {
    color: #16a34a !important;
    font-weight: 800 !important;
  }

  .boat-bill-dashed-divider {
    border-bottom: 1px dashed #cbd5e1 !important;
    margin: 6px 0 4px 0 !important;
    width: 100% !important;
  }

  .boat-bill-main-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding-top: 4px !important;
    cursor: pointer !important;
    user-select: none !important;
  }

  .boat-bill-to-pay-left {
    display: flex !important;
    align-items: baseline !important;
    gap: 8px !important;
  }

  .boat-to-pay-label {
    font-size: 0.95rem !important;
    font-weight: 900 !important;
    color: #0f172a !important;
  }

  .boat-to-pay-value {
    font-size: 1.12rem !important;
    font-weight: 900 !important;
    color: #0f172a !important;
  }

  .boat-bill-toggle-btn {
    background: #f1f5f9 !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 50% !important;
    width: 28px !important;
    height: 28px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    padding: 0 !important;
    color: #0f172a !important;
    transition: background 0.15s ease, transform 0.25s ease !important;
    flex-shrink: 0 !important;
    pointer-events: none !important;
  }

  .boat-bill-main-row:hover .boat-bill-toggle-btn {
    background: #e2e8f0 !important;
  }

  .boat-bill-arrow {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    transform: rotate(0deg) !important; /* Default = Arrow Down */
  }

  .boat-bill-card.is-open .boat-bill-arrow,
  .boat-bill-toggle-btn.is-open .boat-bill-arrow {
    transform: rotate(180deg) !important; /* Open = Arrow Up */
  }

  .cart-drawer__content {
    height: calc(100% - 60px);
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: #f8fafc !important;
    flex-grow: 1;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch !important;
    overscroll-behavior: contain !important;
    touch-action: pan-y !important;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding: 12px 12px !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch !important;
    overscroll-behavior: contain !important;
    touch-action: pan-y !important;
    gap: 8px !important;
  }

  .cart-items__table {
    display: block !important;
    width: 100% !important;
    border-collapse: collapse !important;
  }

  .cart-items__table tbody {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    width: 100% !important;
  }

  .cart-items__table-row,
  .cart-items__table-row--full-width-variants {
    display: grid !important;
    grid-template-columns: 68px 1fr auto !important;
    grid-template-rows: auto auto !important;
    grid-template-areas:
      "media details details"
      "media quantity price" !important;
    column-gap: 12px !important;
    row-gap: 8px !important;
    align-items: center !important;
    padding: 12px !important;
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 12px !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03) !important;
    position: relative !important;
    box-sizing: border-box !important;
    width: 100% !important;
    margin-bottom: 0 !important;
  }

  .cart-items__media {
    grid-area: media !important;
    grid-row: 1 / span 2 !important;
    width: 68px !important;
    height: 68px !important;
    min-width: 68px !important;
    min-height: 68px !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    border: 1px solid #e2e8f0 !important;
    background: #f8fafc !important;
    padding: 0 !important;
    align-self: start !important;
  }

  .cart-items__media-container {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .cart-items__media-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 8px !important;
  }

  .cart-items__details,
  .cart-items__table-row .cart-items__details,
  .cart-items__table-row--full-width-variants .cart-items__details {
    grid-area: details !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
    padding: 0 !important;
    min-width: 0 !important;
  }

  .cart-items__product-info {
    min-width: 0 !important;
    width: 100% !important;
  }

  .cart-items__title-row {
    display: flex !important;
    align-items: flex-start !important;
    gap: 4px !important;
    width: 100% !important;
  }

