{{ 'boat-header-megamenu.css' | asset_url | stylesheet_tag }}

<div class="db-page-wrapper section-{{ section.id }}">
  <div class="db-policy-container">
    
    {% comment %} --- SEO Breadcrumbs --- {% endcomment %}
    <nav class="db-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="db-breadcrumb-sep">/</span>
      <span class="db-breadcrumb-current">{{ page.title | default: 'Shipping & Returns' }}</span>
    </nav>

    {% comment %} --- Hero Header --- {% endcomment %}
    <div class="db-policy-header">
      <span class="db-badge">{{ section.settings.badge_text | default: 'DEALBAZAAR TRUST & QUALITY GUARANTEE' }}</span>
      <h1 class="db-policy-title">{{ section.settings.heading | default: 'Shipping, Delivery & Return Policy' }}</h1>
      <p class="db-policy-subtitle">
        {{ section.settings.subheading | default: 'At DealBazaar, our priority is providing high-quality products with fast nationwide delivery and a completely risk-free shopping experience across Pakistan.' }}
      </p>
    </div>

    {% comment %} --- 4 Trust Pillars Highlight Cards --- {% endcomment %}
    <div class="db-trust-pillars">
      
      <div class="db-pillar-card">
        <div class="db-pillar-icon" style="background: #e0f2fe; color: #0284c7;">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <h3>2 - 4 Days Express Delivery</h3>
        <p>Dispatched within 24 hours via premium logistics partners across all major Pakistani cities.</p>
      </div>

      <div class="db-pillar-card">
        <div class="db-pillar-icon" style="background: #dcfce7; color: #16a34a;">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <line x1="12" y1="8" x2="12" y2="16"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
        </div>
        <h3>100% Cash on Delivery</h3>
        <p>Pay conveniently in cash at your doorstep when you receive the parcel.</p>
      </div>

      <div class="db-pillar-card">
        <div class="db-pillar-icon" style="background: #fef3c7; color: #d97706;">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3>7-Day Replacement Warranty</h3>
        <p>Complete peace of mind with our straightforward replacement policy for any damaged or defective item.</p>
      </div>

      <div class="db-pillar-card">
        <div class="db-pillar-icon" style="background: #dcfce7; color: #16a34a;">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.761.881 2.796.881 3.179 0 5.766-2.587 5.767-5.766.001-3.181-2.585-5.768-5.767-5.768zm0-2.172c4.418 0 8 3.582 8 8 0 4.418-3.582 8-8 8-1.408 0-2.73-.367-3.875-1.009l-4.156 1.009 1.109-3.992c-.696-1.164-1.078-2.525-1.078-4.008 0-4.418 3.582-8 8-8z"/>
          </svg>
        </div>
        <h3>24/7 WhatsApp Support</h3>
        <p>Instant human assistance on WhatsApp (+92 310 2492119) for order questions and claims.</p>
      </div>

    </div>

    {% comment %} --- Detailed Policy Sections --- {% endcomment %}
    <div class="db-policy-content-card">

      <section class="db-policy-section">
        <div class="db-policy-section-header">
          <span class="db-policy-num">1</span>
          <h2>Shipping & Nationwide Delivery Timelines</h2>
        </div>
        <div class="db-policy-text">
          <p>DealBazaar provides safe and speedy door-to-door delivery across all provinces and cities in Pakistan, including Azad Kashmir and remote regions.</p>
          <ul class="db-policy-list">
            <li><strong>Karachi, Lahore, Islamabad & Rawalpindi:</strong> 2 to 3 business days.</li>
            <li><strong>All Other Cities & Towns in Pakistan:</strong> 3 to 4 business days.</li>
            <li><strong>Order Dispatch:</strong> All confirmed orders are verified and dispatched from our fulfillment center within 24 hours.</li>
            <li><strong>Live Tracking SMS:</strong> Once dispatched, an automated tracking SMS with your Courier Tracking ID (Trax / PostEx / TCS / Leopards) is sent to your registered phone number.</li>
          </ul>
        </div>
      </section>

      <section class="db-policy-section">
        <div class="db-policy-section-header">
          <span class="db-policy-num">2</span>
          <h2>7-Day Hassle-Free Replacement Policy</h2>
        </div>
        <div class="db-policy-text">
          <p>We want you to be 100% satisfied with your DealBazaar purchase. If the product you receive falls under any of the following conditions, you are entitled to a free replacement within <strong>7 days</strong> of delivery:</p>
          <ul class="db-policy-list">
            <li>Product arrived broken, physically damaged, or crushed in transit.</li>
            <li>Product is malfunctioning or not operating as advertised.</li>
            <li>Wrong item, model, or incorrect color delivered.</li>
            <li>Missing items or accessories inside the package.</li>
          </ul>
        </div>
      </section>

      <section class="db-policy-section">
        <div class="db-policy-section-header">
          <span class="db-policy-num">3</span>
          <h2>How to Claim a Replacement (Step-by-Step)</h2>
        </div>
        <div class="db-policy-text">
          <div class="db-steps-grid">
            <div class="db-step-item">
              <span class="db-step-badge">Step 1</span>
              <h4>Record a Photo / Video</h4>
              <p>Take a quick photo or short unboxing video clearly displaying the issue with the product.</p>
            </div>
            <div class="db-step-item">
              <span class="db-step-badge">Step 2</span>
              <h4>Send to WhatsApp Support</h4>
              <p>WhatsApp our support team at <strong>+92 310 2492119</strong> along with your DealBazaar Order ID.</p>
            </div>
            <div class="db-step-item">
              <span class="db-step-badge">Step 3</span>
              <h4>Receive Brand New Item</h4>
              <p>Once approved, we will dispatch a brand-new replacement parcel right to your doorstep.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="db-policy-section">
        <div class="db-policy-section-header">
          <span class="db-policy-num">4</span>
          <h2>Order Cancellation & Modifications</h2>
        </div>
        <div class="db-policy-text">
          <p>If you wish to change your delivery address, update your phone number, or cancel an order before dispatch, please message our support team on WhatsApp at <strong>+92 310 2492119</strong> within 12 hours of placing the order.</p>
        </div>
      </section>

    </div>

    {% comment %} --- Bottom WhatsApp Support Action Box --- {% endcomment %}
    <div class="db-policy-wa-card">
      <div class="db-policy-wa-info">
        <span class="db-wa-pill">💬 DEALBAZAAR HELPLINE</span>
        <h2>Need Assistance With a Return or Order?</h2>
        <p>Our support team is available Mon – Sat (9:00 AM – 9:00 PM) to help you instantly on WhatsApp.</p>
      </div>
      <a href="https://wa.me/{{ section.settings.whatsapp_number | default: '923102492119' }}?text=Hello%20DealBazaar%20Support,%20I%20need%20help%20with%20my%20order%20replacement." target="_blank" class="db-policy-wa-btn">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.761.881 2.796.881 3.179 0 5.766-2.587 5.767-5.766.001-3.181-2.585-5.768-5.767-5.768zm0-2.172c4.418 0 8 3.582 8 8 0 4.418-3.582 8-8 8-1.408 0-2.73-.367-3.875-1.009l-4.156 1.009 1.109-3.992c-.696-1.164-1.078-2.525-1.078-4.008 0-4.418 3.582-8 8-8z"/>
        </svg>
        <span>Message Support on WhatsApp</span>
      </a>
    </div>

  </div>
</div>

<style>
  .db-page-wrapper {
    background: #f8fafc;
    min-height: 80vh;
    padding: 30px 16px 60px 16px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
  }

  .db-policy-container {
    max-width: 960px;
    margin: 0 auto;
  }

  .db-breadcrumbs {
    font-size: 0.82rem;
    color: #64748b;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .db-breadcrumbs a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .db-breadcrumbs a:hover {
    color: #0f172a;
    text-decoration: underline;
  }

  .db-breadcrumb-sep {
    color: #cbd5e1;
  }

  .db-breadcrumb-current {
    color: #0f172a;
    font-weight: 700;
  }

  .db-policy-header {
    text-align: center;
    margin-bottom: 36px;
  }

  .db-badge {
    display: inline-block;
    background: #e6fcf5;
    color: #00875a;
    border: 1px solid #b2f2bb;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 4px 14px;
    border-radius: 9999px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .db-policy-title {
    font-size: 2.2rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 10px 0;
    letter-spacing: -0.6px;
    line-height: 1.2;
  }

  .db-policy-subtitle {
    font-size: 0.96rem;
    color: #475569;
    max-width: 660px;
    margin: 0 auto;
    line-height: 1.55;
  }

  /* 4 Pillars Grid */
  .db-trust-pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 36px;
  }

  .db-pillar-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 22px 18px;
    text-align: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .db-pillar-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .db-pillar-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px auto;
  }

  .db-pillar-card h3 {
    margin: 0 0 6px 0;
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
  }

  .db-pillar-card p {
    margin: 0;
    font-size: 0.78rem;
    color: #64748b;
    line-height: 1.45;
  }

  /* Content Card */
  .db-policy-content-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 36px 40px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.03);
    margin-bottom: 36px;
  }

  .db-policy-section {
    margin-bottom: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid #f1f5f9;
  }

  .db-policy-section:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .db-policy-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .db-policy-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .db-policy-section-header h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.2px;
  }

  .db-policy-text {
    padding-left: 44px;
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.7;
  }

  .db-policy-text p {
    margin: 0 0 12px 0;
  }

  .db-policy-list {
    margin: 0;
    padding-left: 20px;
  }

  .db-policy-list li {
    margin-bottom: 8px;
    line-height: 1.6;
  }

  /* Step by Step Grid */
  .db-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 14px;
  }

  .db-step-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px;
  }

  .db-step-badge {
    display: inline-block;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 9999px;
    margin-bottom: 8px;
  }

  .db-step-item h4 {
    margin: 0 0 6px 0;
    font-size: 0.9rem;
    font-weight: 800;
    color: #0f172a;
  }

  .db-step-item p {
    margin: 0;
    font-size: 0.8rem;
    color: #64748b;
    line-height: 1.45;
  }

  /* Bottom WhatsApp Card */
  .db-policy-wa-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 20px;
    padding: 32px;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.2);
    flex-wrap: wrap;
  }

  .db-wa-pill {
    display: inline-block;
    background: rgba(37, 211, 102, 0.2);
    color: #25d366;
    border: 1px solid rgba(37, 211, 102, 0.4);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 9999px;
    margin-bottom: 8px;
  }

  .db-policy-wa-info h2 {
    margin: 0 0 6px 0;
    font-size: 1.35rem;
    font-weight: 900;
    color: #ffffff;
  }

  .db-policy-wa-info p {
    margin: 0;
    font-size: 0.88rem;
    color: #94a3b8;
  }

  .db-policy-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25d366;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 9999px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
  }

  .db-policy-wa-btn:hover {
    background: #20ba59;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
  }

  @media screen and (max-width: 768px) {
    .db-policy-title {
      font-size: 1.6rem;
    }

    .db-trust-pillars {
      grid-template-columns: 1fr 1fr;
    }

    .db-policy-content-card {
      padding: 20px 16px;
    }

    .db-policy-text {
      padding-left: 0;
    }

    .db-steps-grid {
      grid-template-columns: 1fr;
    }

    .db-policy-wa-card {
      padding: 20px 16px;
      flex-direction: column;
      text-align: center;
    }

    .db-policy-wa-btn {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
</style>

{% schema %}
{
  "name": "DealBazaar Policy Page",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "DEALBAZAAR TRUST & QUALITY GUARANTEE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping, Delivery & Return Policy"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "At DealBazaar, our priority is providing high-quality products with fast nationwide delivery and a completely risk-free shopping experience across Pakistan."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Support WhatsApp Number (no + or spaces)",
      "default": "923102492119"
    }
  ],
  "presets": [
    {
      "name": "DealBazaar Policy Page"
    }
  ]
}
{% endschema %}
