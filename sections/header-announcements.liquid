

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  id="BoatAnnouncementBar-{{ section.id }}"
  class="boat-announcement-bar color-custom-{{ section.id }}"
  style="--announcement-bg: {{ section.settings.background_color | default: '#000000' }}; --announcement-border: {{ section.settings.divider_color | default: '#333333' }}; --border-bottom-width: {{ section.settings.divider_width | default: 0 }}px;"
>
  <div class="boat-marquee-wrapper">
    <div class="boat-marquee-track">
      {% for repeat in (1..6) %}
        <div class="boat-marquee-content" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
          {% for block in section.blocks %}
            <div class="boat-marquee-item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="boat-marquee-link">
                  <span>{{ block.settings.text }}</span>
                </a>
              {% else %}
                <span class="boat-marquee-text">{{ block.settings.text }}</span>
              {% endif %}
              <span class="boat-marquee-separator">⚡</span>
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    {% comment %} Close / Dismiss Button {% endcomment %}
    <button
      type="button"
      class="boat-announcement-close"
      aria-label="Close Announcement Bar"
      title="Close Announcement"
      onclick="closeBoatAnnouncementBar('{{ section.id }}')"
    >
      ✕
    </button>
  </div>
</aside>

<style>
  .boat-announcement-bar {
    width: 100%;
    background-color: var(--announcement-bg, #000000);
    border-block-end: var(--border-bottom-width, 0px) solid var(--announcement-border, #333333);
    position: relative;
    overflow: hidden;
    z-index: 9999999;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, padding 0.35s ease;
    max-height: 48px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .boat-announcement-bar.is-closed {
    max-height: 0 !important;
    opacity: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin: 0 !important;
    pointer-events: none !important;
    border: none !important;
  }

  .boat-marquee-wrapper {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 7px 36px 7px 12px;
    box-sizing: border-box;
  }

  .boat-marquee-track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    will-change: transform;
    animation: boatMarqueeScroll 28s linear infinite;
  }

  .boat-marquee-track:hover {
    animation-play-state: paused;
  }

  .boat-marquee-content {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .boat-marquee-item {
    display: inline-flex;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    color: #ffffff;
    padding: 0 16px;
  }

  .boat-marquee-link {
    color: #ffffff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .boat-marquee-link:hover {
    opacity: 0.85;
    text-decoration: underline;
  }

  .boat-marquee-text {
    color: #ffffff;
  }

  .boat-marquee-separator {
    margin-left: 24px;
    color: #ffd700;
    font-size: 0.75rem;
    opacity: 0.9;
  }

  .boat-announcement-close {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.15);
    border: none;
    color: #ffffff;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 11px;
    font-weight: 800;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 10;
    padding: 0;
    line-height: 1;
  }

  .boat-announcement-close:hover {
    background: rgba(255, 255, 255, 0.35);
    transform: translateY(-50%) scale(1.1);
  }

  @keyframes boatMarqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .boat-announcement-bar {
      max-height: 42px;
    }

    .boat-marquee-wrapper {
      padding: 6px 32px 6px 8px;
    }

    .boat-marquee-item {
      font-size: 0.74rem;
      padding: 0 12px;
    }

    .boat-marquee-separator {
      margin-left: 18px;
    }
  }
</style>

<script>
  function closeBoatAnnouncementBar(sectionId) {
    const bar = document.getElementById('BoatAnnouncementBar-' + sectionId);
    if (bar) {
      bar.classList.add('is-closed');
      try {
        sessionStorage.setItem('boat_announcement_closed', '1');
      } catch(e) {}
    }
  }

  (function initBoatAnnouncementState() {
    try {
      if (sessionStorage.getItem('boat_announcement_closed') === '1') {
        const bars = document.querySelectorAll('.boat-announcement-bar');
        bars.forEach(b => b.classList.add('is-closed'));
      }
    } catch(e) {}
  })();
</script>

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
