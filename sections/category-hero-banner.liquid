{% comment %} --- Auto Play Carousel Script (Hero Slider & Mobile Categories Bar) --- {% endcomment %}
<script>
  (function() {
    {% if section.settings.enable_autoplay and show_hero_content %}
      const slider = document.getElementById('HeroSlider-{{ section.id }}');
      const dots = document.querySelectorAll('#HeroDots-{{ section.id }} .category-hero__dot');

      if (slider) {
        const speed = Math.max(2, parseInt({{ section.settings.autoplay_speed | default: 5 }})) * 1000;
        let autoplayTimer = setInterval(nextSlide, speed);

        function updateDots(index) {
          if (!dots || dots.length === 0) return;
          dots.forEach((dot, idx) => {
            if (idx === index) {
              dot.classList.add('category-hero__dot--active');
            } else {
              dot.classList.remove('category-hero__dot--active');
            }
          });
        }

        function nextSlide() {
          const slideWidth = slider.clientWidth;
          const maxScroll = slider.scrollWidth - slideWidth;
          let nextScroll = slider.scrollLeft + slideWidth;
          
          if (slider.scrollLeft >= maxScroll - 10) {
            slider.scrollTo({ left: 0, behavior: 'smooth' });
            updateDots(0);
          } else {
            slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
            const currentIndex = Math.round((slider.scrollLeft + slideWidth) / slideWidth);
            updateDots(currentIndex);
          }
        }

        slider.addEventListener('scroll', () => {
          const slideWidth = slider.clientWidth;
          const currentIndex = Math.round(slider.scrollLeft / slideWidth);
          updateDots(currentIndex);
        });

        {% if section.settings.pause_autoplay_on_hover != false %}
          slider.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
          slider.addEventListener('mouseleave', () => {
            clearInterval(autoplayTimer);
            autoplayTimer = setInterval(nextSlide, speed);
          });
        {% endif %}

        // Mobile touch & hover interaction for navigation arrows & pause
        const heroMain = slider.closest('.category-hero__main');
        if (heroMain) {
          let touchTimer;
          heroMain.addEventListener('touchstart', () => {
            heroMain.classList.add('is-interacting');
            {% if section.settings.pause_autoplay_on_hover != false %}
              clearInterval(autoplayTimer);
            {% endif %}
            clearTimeout(touchTimer);
          }, { passive: true });

          heroMain.addEventListener('touchend', () => {
            clearTimeout(touchTimer);
            {% if section.settings.pause_autoplay_on_hover != false %}
              clearInterval(autoplayTimer);
              autoplayTimer = setInterval(nextSlide, speed);
            {% endif %}
            touchTimer = setTimeout(() => {
              heroMain.classList.remove('is-interacting');
            }, 3000);
          }, { passive: true });
        }
      }
    {% endif %}

    const catBar = document.getElementById('MobileCategoryBarContainer-{{ section.id }}');
    if (catBar) {
      {% if section.settings.enable_mobile_category_autoplay and show_categories_mobile %}
        const catSpeed = ({{ section.settings.mobile_category_autoplay_speed | default: 3 }}) * 1000;
        let catTimer = setInterval(scrollNextCat, catSpeed);

        function scrollNextCat() {
          const maxScroll = catBar.scrollWidth - catBar.clientWidth;
          if (catBar.scrollLeft >= maxScroll - 15) {
            catBar.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            catBar.scrollBy({ left: 160, behavior: 'smooth' });
          }
        }

        catBar.addEventListener('touchstart', () => clearInterval(catTimer), {passive: true});
        catBar.addEventListener('touchend', () => {
          clearInterval(catTimer);
          catTimer = setInterval(scrollNextCat, catSpeed);
        }, {passive: true});
      {% endif %}

      // --- Mouse Drag-to-Scroll & Mouse Wheel Horizontal Scroll ---
      let isDown = false;
      let startX;
      let scrollLeft;
      let hasDragged = false;

      catBar.addEventListener('mousedown', (e) => {
        isDown = true;
        hasDragged = false;
        catBar.classList.add('is-dragging');
        startX = e.pageX - catBar.offsetLeft;
        scrollLeft = catBar.scrollLeft;
      });

      catBar.addEventListener('mouseleave', () => {
        isDown = false;
        catBar.classList.remove('is-dragging');
      });

      catBar.addEventListener('mouseup', () => {
        isDown = false;
        catBar.classList.remove('is-dragging');
      });

      catBar.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        const x = e.pageX - catBar.offsetLeft;
        const walk = (x - startX) * 1.5;
        if (Math.abs(walk) > 4) {
          hasDragged = true;
          e.preventDefault();
          catBar.scrollLeft = scrollLeft - walk;
        }
      });

      // Prevent link clicking only when dragged
      catBar.addEventListener('click', (e) => {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      // Mouse Wheel Horizontal Scroll
      catBar.addEventListener('wheel', (e) => {
        if (e.deltaY !== 0) {
          e.preventDefault();
          catBar.scrollLeft += e.deltaY;
        }
      }, { passive: false });
    }
  })();
</script>

