{{ 'boat-header-megamenu.css' | asset_url | stylesheet_tag }}

{% liquid
  assign sidebar_menu = section.settings.sidebar_menu
  assign is_homepage = false
  if template.name == 'index'
    assign is_homepage = true
  endif

  assign show_only_on_homepage = section.settings.show_only_on_homepage

  # Determine if Hero Slider & Promo Banners should be shown
  assign show_hero_content = true
  if show_only_on_homepage and is_homepage == false
    assign show_hero_content = false
  endif

  # Categories visibility checks
  assign show_categories_desktop = section.settings.show_categories_desktop
  assign show_categories_mobile = section.settings.show_categories_mobile

  if is_homepage == false
    assign show_categories_desktop = section.settings.show_categories_on_collection_desktop
    assign show_categories_mobile = section.settings.show_categories_on_collection_mobile
  endif

  assign show_promos_desktop = section.settings.show_promos_desktop
  assign show_promos_mobile = section.settings.show_promos_mobile

  if show_hero_content == false
    assign show_promos_desktop = false
    assign show_promos_mobile = false
  endif

  # Check if desktop or mobile have any visible content
  assign has_desktop_content = false
  if show_categories_desktop or show_hero_content or show_promos_desktop
    assign has_desktop_content = true
  endif

  assign has_mobile_content = false
  if show_categories_mobile or show_hero_content or show_promos_mobile
    assign has_mobile_content = true
  endif

  # Determine dynamic container layout class
  if show_categories_desktop and show_promos_desktop
    assign container_class = 'category-hero__container--full'
  elsif show_categories_desktop and show_promos_desktop == false
    assign container_class = 'category-hero__container--no-promo'
  elsif show_categories_desktop == false and show_promos_desktop
    assign container_class = 'category-hero__container--no-sidebar'
  else
    assign container_class = 'category-hero__container--hero-only'
  endif
%}

{% if has_desktop_content or has_mobile_content %}
  <style>
    .section-{{ section.id }} {
      background-color: {{ section.settings.section_bg_color | default: '#f7f8fa' }} !important;
    }
    .section-{{ section.id }} .category-hero__sidebar {
      background-color: {{ section.settings.sidebar_bg_color | default: '#ffffff' }} !important;
    }
    .section-{{ section.id }} .category-hero__sidebar-header {
      color: {{ section.settings.sidebar_header_color | default: '#71778e' }} !important;
    }
    .section-{{ section.id }} .category-hero__sidebar-link {
      color: {{ section.settings.sidebar_text_color | default: '#2c3038' }} !important;
    }
    .section-{{ section.id }} .category-hero__mobile-bar {
      background-color: {{ section.settings.mobile_bar_bg | default: '#ffffff' }} !important;
    }
    .section-{{ section.id }} .category-hero__mobile-link {
      background-color: {{ section.settings.mobile_pill_bg | default: '#f3f5f9' }} !important;
      color: {{ section.settings.mobile_pill_text | default: '#1a1a1a' }} !important;
    }
    .section-{{ section.id }} .category-hero__slide-title {
      color: {{ section.settings.slide_title_color | default: '#ffffff' }};
    }
    .section-{{ section.id }} .category-hero__slide-subtitle {
      color: {{ section.settings.slide_subtitle_color | default: '#ffffff' }};
    }
    .section-{{ section.id }} .category-hero__slide-btn {
      background-color: {{ section.settings.slide_button_bg | default: '#ffffff' }};
      color: {{ section.settings.slide_button_text | default: '#000000' }};
    }
    .section-{{ section.id }} .category-hero__promo-badge {
      background-color: {{ section.settings.promo_badge_bg | default: 'rgba(0, 0, 0, 0.8)' }};
      color: {{ section.settings.promo_badge_text | default: '#ffffff' }};
    }
    .section-{{ section.id }} .category-hero__main,
    .section-{{ section.id }} .category-hero__slide {
      min-height: {{ section.settings.hero_height_desktop }}px;
    }
    {% unless has_desktop_content %}
      @media (min-width: 769px) {
        .section-{{ section.id }} {
          display: none !important;
        }
      }
    {% endunless %}
    {% unless has_mobile_content %}
      @media (max-width: 768px) {
        .section-{{ section.id }} {
          display: none !important;
        }
      }
    {% endunless %}
    @media (max-width: 768px) {
      .section-{{ section.id }} .category-hero__main,
      .section-{{ section.id }} .category-hero__slide {
        min-height: {{ section.settings.hero_height_mobile }}px;
      }
    }
  </style>

  <div class="category-hero-section section-{{ section.id }}">
    
    {% comment %} --- Mobile Top Categories Horizontal Carousel Pill Bar --- {% endcomment %}
    {% if show_categories_mobile %}
      <div class="category-hero__mobile-bar category-hero__mobile-bar--show" id="MobileCategoryBarContainer-{{ section.id }}">
        <ul class="category-hero__mobile-list" role="list">
          {% if sidebar_menu != blank and sidebar_menu.links.size > 0 %}
            {% for link in sidebar_menu.links %}
              <li class="category-hero__mobile-item">
                <a href="{{ link.url }}" class="category-hero__mobile-link">
                  {% if link.type == 'collection_link' and link.object.featured_image != blank %}
                    <img src="{{ link.object.featured_image | image_url: width: 40 }}" alt="{{ link.title | escape }}" class="category-hero__mobile-icon" loading="lazy" width="18" height="18">
                  {% else %}
                    <span>🏷️</span>
                  {% endif %}
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          {% else %}
            {% assign category_blocks = section.blocks | where: 'type', 'category_item' %}
            {% if category_blocks.size > 0 %}
              {% for block in category_blocks %}
                <li class="category-hero__mobile-item" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.url | default: '#' }}" class="category-hero__mobile-link">
                    {% if block.settings.icon != blank %}
                      <img src="{{ block.settings.icon | image_url: width: 40 }}" alt="{{ block.settings.title | escape }}" class="category-hero__mobile-icon" loading="lazy" width="18" height="18">
                    {% endif %}
                    <span>{{ block.settings.title }}</span>
                  </a>
                </li>
              {% endfor %}
            {% else %}
              <li class="category-hero__mobile-item"><a href="/collections/all" class="category-hero__mobile-link">📱 Mobiles</a></li>
              <li class="category-hero__mobile-item"><a href="/collections/all" class="category-hero__mobile-link">👔 Men's Fashion</a></li>
              <li class="category-hero__mobile-item"><a href="/collections/all" class="category-hero__mobile-link">👗 Women Fashion</a></li>
              <li class="category-hero__mobile-item"><a href="/collections/all" class="category-hero__mobile-link">🔌 Appliances</a></li>
              <li class="category-hero__mobile-item"><a href="/collections/all" class="category-hero__mobile-link">📺 TV & Video</a></li>
              <li class="category-hero__mobile-item"><a href="/collections/all" class="category-hero__mobile-link">🎧 Audio</a></li>
            {% endif %}
          {% endif %}
        </ul>
      </div>
    {% endif %}

    {% comment %} Render Main Section Container only if desktop categories, hero content, or promos are active {% endcomment %}
    {% if show_categories_desktop or show_hero_content or show_promos_desktop %}
      <div class="category-hero__container {{ container_class }}">
        
        {% comment %} --- Left Sidebar: TOP CATEGORIES (Desktop) with Hover Flyout Mega Menu --- {% endcomment %}
        {% if show_categories_desktop %}
          <aside class="category-hero__sidebar hero-hide-mobile">
            <div class="category-hero__sidebar-header">
              <span>{{ section.settings.sidebar_heading | default: 'TOP CATEGORIES' }}</span>
            </div>
            <ul class="category-hero__sidebar-list" role="list">
              {% if sidebar_menu != blank and sidebar_menu.links.size > 0 %}
                {% for link in sidebar_menu.links %}
                  <li class="category-hero__sidebar-item{% if link.links.size > 0 %} category-hero__sidebar-item--has-flyout{% endif %}">
                    <a href="{{ link.url }}" class="category-hero__sidebar-link">
                      <div class="category-hero__sidebar-left-info">
                        {% if link.type == 'collection_link' and link.object.featured_image != blank %}
                          <img src="{{ link.object.featured_image | image_url: width: 60 }}" alt="{{ link.title | escape }}" class="category-hero__sidebar-icon" loading="lazy" width="22" height="22">
                        {% else %}
                          <span class="category-hero__sidebar-icon-placeholder">🏷️</span>
                        {% endif %}
                        <span>{{ link.title }}</span>
                      </div>
                      {% if link.links.size > 0 %}
                        <span class="category-hero__sidebar-chevron">›</span>
                      {% endif %}
                    </a>

                    {% if link.links.size > 0 %}
                      <div class="category-hero__flyout">
                        <div class="category-hero__flyout-inner">
                          {% for sub_link in link.links %}
                            <div class="category-hero__flyout-column">
                              <a href="{{ sub_link.url }}" class="category-hero__flyout-heading">{{ sub_link.title }}</a>
                              {% if sub_link.links.size > 0 %}
                                <ul class="category-hero__flyout-list" role="list">
                                  {% for child_link in sub_link.links %}
                                    <li>
                                      <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                                    </li>
                                  {% endfor %}
                                </ul>
                              {% endif %}
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endif %}
                  </li>
                {% endfor %}
              {% else %}
                {% assign category_blocks = section.blocks | where: 'type', 'category_item' %}
                {% if category_blocks.size > 0 %}
                  {% for block in category_blocks %}
                    <li class="category-hero__sidebar-item" {{ block.shopify_attributes }}>
                      <a href="{{ block.settings.url | default: '#' }}" class="category-hero__sidebar-link">
                        <div class="category-hero__sidebar-left-info">
                          {% if block.settings.icon != blank %}
                            <img src="{{ block.settings.icon | image_url: width: 60 }}" alt="{{ block.settings.title | escape }}" class="category-hero__sidebar-icon" loading="lazy" width="22" height="22">
                          {% endif %}
                          <span>{{ block.settings.title }}</span>
                        </div>
                      </a>
                    </li>
                  {% endfor %}
                {% else %}
                  {% comment %} Demo Fallback with Hover Flyout (Matching Screenshot) {% endcomment %}
                  <li class="category-hero__sidebar-item category-hero__sidebar-item--has-flyout">
                    <a href="/collections/all" class="category-hero__sidebar-link">
                      <div class="category-hero__sidebar-left-info">
                        <span class="category-hero__sidebar-icon">📱</span>
                        <span>Mobiles & Tablets</span>
                      </div>
                      <span class="category-hero__sidebar-chevron">›</span>
                    </a>
                    <div class="category-hero__flyout">
                      <div class="category-hero__flyout-inner">
                        <div class="category-hero__flyout-column">
                          <a href="/collections/all" class="category-hero__flyout-heading">Smartphones</a>
                          <ul class="category-hero__flyout-list" role="list">
                            <li><a href="/collections/all">Apple iPhones</a></li>
                            <li><a href="/collections/all">Asus Mobiles</a></li>
                            <li><a href="/collections/all">Gfive Mobiles</a></li>
                            <li><a href="/collections/all">Huawei Mobiles</a></li>
                            <li><a href="/collections/all">View more</a></li>
                          </ul>
                          <a href="/collections/all" class="category-hero__flyout-heading" style="margin-top: 16px;">Tablet Accessories</a>
                        </div>
                        <div class="category-hero__flyout-column">
                          <a href="/collections/all" class="category-hero__flyout-heading">Mobile Accessories</a>
                          <ul class="category-hero__flyout-list" role="list">
                            <li><a href="/collections/all">Wireless Chargers</a></li>
                            <li><a href="/collections/all">Gadgets & Accessories</a></li>
                            <li><a href="/collections/all">Memory Cards</a></li>
                            <li><a href="/collections/all">Customised Cases & Covers</a></li>
                            <li><a href="/collections/all">View more</a></li>
                          </ul>
                          <a href="/collections/all" class="category-hero__flyout-heading" style="margin-top: 16px;">Feature Phones</a>
                        </div>
                        <div class="category-hero__flyout-column">
                          <a href="/collections/all" class="category-hero__flyout-heading">Tablets</a>
                          <ul class="category-hero__flyout-list" role="list">
                            <li><a href="/collections/all">iOS Tablet</a></li>
                            <li><a href="/collections/all">Windows Tablets</a></li>
                            <li><a href="/collections/all">Android Tablets</a></li>
                            <li><a href="/collections/all">Amazon Tablets</a></li>
                          </ul>
                        </div>
                      </div>
                    </div>
                  </li>

                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">👔</span><span>Men's Fashion</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">👗</span><span>Women Fashion</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">🔌</span><span>Appliances</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">📺</span><span>TV & Video</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">🧸</span><span>Kidsmart</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">🏠</span><span>Home & Living</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">💻</span><span>Computer & Gaming</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">🚗</span><span>Automotive</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">❤️</span><span>Health & Care</span></div></a></li>
                  <li class="category-hero__sidebar-item"><a href="/collections/all" class="category-hero__sidebar-link"><div class="category-hero__sidebar-left-info"><span class="category-hero__sidebar-icon">📷</span><span>Camera</span></div></a></li>
                {% endif %}
              {% endif %}
            </ul>
          </aside>
        {% endif %}

        {% comment %} --- Middle Column: Main Hero Banner Slider (Multi Banner Support) --- {% endcomment %}
        {% if show_hero_content %}
          <main class="category-hero__main">
            {% assign slide_blocks = section.blocks | where: 'type', 'slide_item' %}
            <div class="category-hero__slider" id="HeroSlider-{{ section.id }}">
              {% if slide_blocks.size > 0 %}
                {% for block in slide_blocks %}
                  {% liquid
                    assign s_title_color = block.settings.title_color | default: section.settings.slide_title_color | default: '#ffffff'
                    assign s_subtitle_color = block.settings.subtitle_color | default: section.settings.slide_subtitle_color | default: '#ffffff'
                    assign s_btn_bg = block.settings.button_bg_color | default: section.settings.slide_button_bg | default: '#ffffff'
                    assign s_btn_text = block.settings.button_text_color | default: section.settings.slide_button_text | default: '#000000'
                    
                    # Vertical Position
                    assign v_pos = block.settings.content_position_vertical
                    if v_pos == blank or v_pos == 'default'
                      assign v_pos = section.settings.content_position_vertical | default: 'bottom'
                    endif

                    # Horizontal Position
                    assign h_pos = block.settings.content_position_horizontal
                    if h_pos == blank or h_pos == 'default'
                      assign h_pos = block.settings.text_alignment
                    endif
                    if h_pos == blank or h_pos == 'default'
                      assign h_pos = section.settings.content_position_horizontal | default: 'left'
                    endif

                    # Vertical justify & gradient
                    if v_pos == 'top'
                      assign justify_css = 'flex-start'
                      assign overlay_bg_css = 'linear-gradient(180deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 60%)'
                    elsif v_pos == 'center'
                      assign justify_css = 'center'
                      assign overlay_bg_css = 'linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.45) 100%)'
                    else
                      assign justify_css = 'flex-end'
                      assign overlay_bg_css = 'linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.75) 100%)'
                    endif

                    # Horizontal alignment
                    if h_pos == 'center'
                      assign align_css = 'center'
                      assign text_align_css = 'center'
                    elsif h_pos == 'right'
                      assign align_css = 'flex-end'
                      assign text_align_css = 'right'
                    else
                      assign align_css = 'flex-start'
                      assign text_align_css = 'left'
                    endif
                  %}
                  <div class="category-hero__slide" {{ block.shopify_attributes }}>
                    {% if block.settings.slide_url != blank %}
                      <a href="{{ block.settings.slide_url }}" class="category-hero__slide-link">
                    {% endif %}

                    {% if block.settings.image_mobile != blank %}
                      <img src="{{ block.settings.image_mobile | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="category-hero__slide-img-mobile category-hero__slide-img-mobile--active" loading="eager" width="400" height="280">
                    {% endif %}

                    {% if block.settings.image_desktop != blank %}
                      <img src="{{ block.settings.image_desktop | image_url: width: 1600 }}" alt="{{ block.settings.title | escape }}" class="category-hero__slide-img-desktop" loading="eager" width="800" height="400">
                    {% elsif block.settings.image_mobile == blank %}
                      <div class="category-hero__slide-img-desktop" style="background: linear-gradient(135deg, #111111 0%, #2b303a 100%); width:100%; height:100%;"></div>
                    {% endif %}

                    {% if block.settings.title != blank or block.settings.subtitle != blank or block.settings.button_label != blank %}
                      <div class="category-hero__slide-overlay" style="justify-content: {{ justify_css }}; align-items: {{ align_css }}; text-align: {{ text_align_css }}; background: {{ overlay_bg_css }};">
                        {% if block.settings.title != blank %}
                          <h2 class="category-hero__slide-title" style="color: {{ s_title_color }} !important;">{{ block.settings.title }}</h2>
                        {% endif %}
                        {% if block.settings.subtitle != blank %}
                          <p class="category-hero__slide-subtitle" style="color: {{ s_subtitle_color }} !important;">{{ block.settings.subtitle }}</p>
                        {% endif %}
                        {% if block.settings.button_label != blank %}
                          {% if block.settings.button_link != blank and block.settings.slide_url == blank %}
                            <a href="{{ block.settings.button_link }}" class="category-hero__slide-btn" style="background-color: {{ s_btn_bg }} !important; color: {{ s_btn_text }} !important;">{{ block.settings.button_label }}</a>
                          {% else %}
                            <span class="category-hero__slide-btn" style="background-color: {{ s_btn_bg }} !important; color: {{ s_btn_text }} !important;">{{ block.settings.button_label }}</span>
                          {% endif %}
                        {% endif %}
                      </div>
                    {% endif %}

                    {% if block.settings.slide_url != blank %}
                      </a>
                    {% endif %}
                  </div>
                {% endfor %}
              {% else %}
                <div class="category-hero__slide">
                  <div class="category-hero__slide-img-desktop" style="background: linear-gradient(135deg, #050505 0%, #1c2517 100%); width:100%; height:100%;"></div>
                  <div class="category-hero__slide-overlay" style="justify-content: flex-end; align-items: flex-start; text-align: left;">
                    <h2 class="category-hero__slide-title">SOUND. STYLE.<br>SMART LIVING.</h2>
                    <p class="category-hero__slide-subtitle">Premium Audio. Smarter Tech. Better Every Day.</p>
                    <a href="/collections/all" class="category-hero__slide-btn">EXPLORE NOW</a>
                  </div>
                </div>
              {% endif %}
            </div>

            {% assign show_nav_arrows = section.settings.show_arrows %}
            {% if show_nav_arrows == nil %}{% assign show_nav_arrows = true %}{% endif %}
            {% assign show_nav_dots = section.settings.show_dots %}
            {% if show_nav_dots == nil %}{% assign show_nav_dots = true %}{% endif %}

            {% if slide_blocks.size > 1 and show_nav_arrows %}
              <button type="button" class="category-hero__slider-nav category-hero__slider-nav--prev" onclick="document.getElementById('HeroSlider-{{ section.id }}').scrollBy({left: -600, behavior: 'smooth'})" aria-label="Previous Slide">‹</button>
              <button type="button" class="category-hero__slider-nav category-hero__slider-nav--next" onclick="document.getElementById('HeroSlider-{{ section.id }}').scrollBy({left: 600, behavior: 'smooth'})" aria-label="Next Slide">›</button>
            {% endif %}

            {% if slide_blocks.size > 1 and show_nav_dots %}
              <div class="category-hero__slider-dots" id="HeroDots-{{ section.id }}">
                {% for block in slide_blocks %}
                  <button type="button" class="category-hero__dot{% if forloop.first %} category-hero__dot--active{% endif %}" onclick="document.getElementById('HeroSlider-{{ section.id }}').scrollTo({left: {{ forloop.index0 }} * document.getElementById('HeroSlider-{{ section.id }}').clientWidth, behavior: 'smooth'})" aria-label="Slide {{ forloop.index }}"></button>
                {% endfor %}
              </div>
            {% endif %}
          </main>
        {% endif %}

        {% comment %} --- Right Column: Stacked Promo Banners --- {% endcomment %}
        {% if show_promos_desktop or show_promos_mobile %}
          {% assign promo_class = '' %}
          {% if show_promos_desktop == false %}
            {% assign promo_class = promo_class | append: ' hero-hide-desktop' %}
          {% endif %}
          {% if show_promos_mobile == false %}
            {% assign promo_class = promo_class | append: ' hero-hide-mobile' %}
          {% endif %}

          <aside class="category-hero__right {{ promo_class }}">
            {% assign promo_blocks = section.blocks | where: 'type', 'promo_banner' %}
            {% if promo_blocks.size > 0 %}
              {% for block in promo_blocks limit: 2 %}
                {% liquid
                  assign p_badge_bg = block.settings.badge_bg_color | default: section.settings.promo_badge_bg | default: 'rgba(0, 0, 0, 0.8)'
                  assign p_badge_text = block.settings.badge_text_color | default: section.settings.promo_badge_text | default: '#ffffff'
                  assign p_title_color = block.settings.title_color | default: section.settings.promo_title_color | default: '#ffffff'
                %}
                <a href="{{ block.settings.link | default: '#' }}" class="category-hero__promo-card" {{ block.shopify_attributes }}>
                  {% if block.settings.badge_text != blank %}
                    <span class="category-hero__promo-badge" style="background-color: {{ p_badge_bg }} !important; color: {{ p_badge_text }} !important;">{{ block.settings.badge_text }}</span>
                  {% endif %}
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="300" height="180">
                  {% else %}
                    <div style="background: #1e2530; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: {{ p_title_color }} !important; font-weight: 700; padding: 20px;">
                      {{ block.settings.title | default: 'PROMO BANNER' }}
                    </div>
                  {% endif %}
                </a>
              {% endfor %}
            {% else %}
              <a href="/collections/all" class="category-hero__promo-card">
                <span class="category-hero__promo-badge">STARTING FROM RS. 599/-</span>
                <div style="background: linear-gradient(135deg, #dce4ee 0%, #b8c4d4 100%); width: 100%; height: 100%; min-height: 180px; display: flex; flex-direction: column; justify-content: flex-end; padding: 20px; color: #0f172a;">
                  <strong style="font-size: 1.2rem; text-transform: uppercase;">SMART EARBUDS</strong>
                </div>
              </a>
              <a href="/collections/all" class="category-hero__promo-card">
                <span class="category-hero__promo-badge">STARTING FROM RS. 799/-</span>
                <div style="background: linear-gradient(135deg, #c7d2fe 0%, #818cf8 100%); width: 100%; height: 100%; min-height: 180px; display: flex; flex-direction: column; justify-content: flex-end; padding: 20px; color: #0f172a;">
