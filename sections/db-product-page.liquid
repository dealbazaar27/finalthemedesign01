    border: 1.5px solid #cbd5e1;
    background: #f8fafc;
    color: #1e293b;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    box-sizing: border-box;
  }

  .boat-pdp-pill-btn:hover {
    border-color: #0f172a;
    background: #ffffff;
  }

  .boat-pdp-pill-btn.active {
    border-color: #0f172a;
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.2);
  }

  /* Quantity Stepper */
  .boat-pdp-qty-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-pdp-qty-label {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
  }

  .boat-pdp-qty-stepper {
    display: flex;
    align-items: center;
    background: #f1f5f9;
    border-radius: 24px;
    padding: 3px 6px;
    border: 1px solid #e2e8f0;
    box-sizing: border-box;
  }

  .boat-pdp-qty-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-size: 1.15rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    box-sizing: border-box;
  }

  .boat-pdp-qty-btn:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .boat-pdp-qty-input {
    width: 38px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    outline: none;
    -moz-appearance: textfield;
  }

  .boat-pdp-qty-input::-webkit-outer-spin-button,
  .boat-pdp-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Dynamic Subtotal Row with Discount Tag */
  .boat-pdp-subtotal-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
    padding: 10px 16px;
    background: #f8fafc;
    border-radius: 12px;
    border: 1.5px dashed #cbd5e1;
    width: 100%;
    box-sizing: border-box;
    flex-wrap: wrap;
  }

  .boat-pdp-subtotal-left {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .boat-pdp-subtotal-label {
    font-size: 0.88rem;
    font-weight: 800;
    color: #475569;
  }

  .boat-pdp-subtotal-val {
    font-size: 1.25rem;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.3px;
  }

  .boat-pdp-subtotal-compare {
    font-size: 0.9rem;
    color: #94a3b8;
    text-decoration: line-through;
    font-weight: 600;
  }

  .boat-pdp-subtotal-discount-tag {
