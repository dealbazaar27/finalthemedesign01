    box-sizing: border-box;
  }

  .boat-pdp-offer-card:hover .boat-pdp-offer-code,
  .boat-pdp-offer-card.active .boat-pdp-offer-code {
    background: #ffffff;
    border-style: solid;
  }

  /* In-Page Action CTA Buttons */
  .boat-pdp-cta-group {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 14px 0 8px 0;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-pdp-btn {
    flex: 1 1 0;
    width: 50%;
    min-width: 0;
    height: 48px;
    border-radius: 26px;
    font-size: 0.95rem;
    font-weight: 800;
    border: none;
