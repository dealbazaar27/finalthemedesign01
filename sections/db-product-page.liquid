  .boat-pdp-offer-qty {
    font-size: 0.78rem;
    font-weight: 700;
    color: #0f172a;
  }

  .boat-pdp-offer-disc {
    font-size: 0.8rem;
    font-weight: 800;
    color: #00875a;
  }

  .boat-pdp-offer-code {
