  /* Option / Swatch / Pill Selectors */
  .boat-pdp-variant-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-pdp-variant-label {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
  }

  .boat-pdp-variant-val {
    font-weight: 700;
    color: #475569;
  }

  .boat-pdp-swatches-grid {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-pdp-swatch-box {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    border: 2px solid #e2e8f0;
    background: #ffffff;
    padding: 2px;
