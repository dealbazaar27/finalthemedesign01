{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_price = selected_variant.compare_at_price
  assign featured_img = selected_variant.featured_image | default: product.featured_image | default: product.media.first.preview_image
  
  if compare_price > price
    assign discount_percent = compare_price | minus: price | times: 100.0 | divided_by: compare_price | round
  else
    assign discount_percent = 0
  endif

  assign form_id = 'BoatProductPageForm-' | append: product.id

  # Exact Synchronized Deterministic Product Rating matching Top Picks Card Item
  assign id_num = product.id | modulo: 15
  case id_num
    when 0
      assign display_rating = '4.9'
    when 1
      assign display_rating = '4.7'
    when 2
      assign display_rating = '4.2'
    when 3
      assign display_rating = '4.8'
    when 4
      assign display_rating = '3.9'
    when 5
      assign display_rating = '4.5'
    when 6
      assign display_rating = '5.0'
    when 7
      assign display_rating = '4.1'
    when 8
      assign display_rating = '4.6'
    when 9
      assign display_rating = '3.8'
    when 10
      assign display_rating = '4.4'
    when 11
      assign display_rating = '4.9'
    when 12
      assign display_rating = '4.3'
    when 13
      assign display_rating = '4.8'
    else
      assign display_rating = '3.7'
  endcase

  assign id_count_seed = product.id | modulo: 380 | plus: 142
  assign display_reviews_count = id_count_seed

  assign show_rating = section.settings.show_rating
  if show_rating == nil
    assign show_rating = true
  endif

  assign show_timer = section.settings.show_timer
  if show_timer == nil
    assign show_timer = true
  endif

  assign show_deal = section.settings.enable_deals
  if show_deal == nil
    assign show_deal = true
  endif

  assign enable_desktop_sticky = section.settings.enable_desktop_sticky
  if enable_desktop_sticky == nil
    assign enable_desktop_sticky = true
  endif

  assign enable_pdp_tabs = section.settings.enable_pdp_tabs
  if enable_pdp_tabs == nil
    assign enable_pdp_tabs = true
  endif

  assign show_tab_overview = section.settings.show_tab_overview
  if show_tab_overview == nil
    assign show_tab_overview = true
  endif

  assign show_tab_specs = section.settings.show_tab_specs
  if show_tab_specs == nil
    assign show_tab_specs = true
  endif

  assign show_tab_faqs = section.settings.show_tab_faqs
  if show_tab_faqs == nil
    assign show_tab_faqs = true
  endif

  assign show_tab_reviews = section.settings.show_tab_reviews
  if show_tab_reviews == nil
    assign show_tab_reviews = true
  endif

  assign show_mobile_sticky = section.settings.enable_mobile_sticky
  if show_mobile_sticky == nil
    assign show_mobile_sticky = true
  endif

  assign hide_inline_buttons_mobile = section.settings.hide_inline_buttons_mobile
  if hide_inline_buttons_mobile == nil
    assign hide_inline_buttons_mobile = true
  endif

  assign show_sticky_deal_strip = section.settings.show_sticky_deal_strip
  if show_sticky_deal_strip == nil
    assign show_sticky_deal_strip = true
  endif

  if section.settings.deals_tag_filter != blank
    unless product.tags contains section.settings.deals_tag_filter
      assign show_deal = false
    endunless
  endif

  if section.settings.deals_collection_filter != blank
    assign in_col = false
    for c in product.collections
      if c.handle == section.settings.deals_collection_filter
        assign in_col = true
        break
      endif
    endfor
    unless in_col
      assign show_deal = false
    endunless
  endif

  assign t1_qty = section.settings.tier_1_qty | default: 2
  assign t1_disc = section.settings.tier_1_discount | default: 6
  assign t1_code = section.settings.tier_1_code | default: 'DEAL6'
  assign t1_badge = section.settings.tier_1_badge | default: 'MOST POPULAR'

  assign t2_qty = section.settings.tier_2_qty | default: 5
  assign t2_disc = section.settings.tier_2_discount | default: 7
  assign t2_code = section.settings.tier_2_code | default: 'DEAL7'
  assign t2_badge = section.settings.tier_2_badge | default: 'BEST VALUE'

  assign t3_qty = section.settings.tier_3_qty | default: 10
  assign t3_disc = section.settings.tier_3_discount | default: 10
  assign t3_code = section.settings.tier_3_code | default: 'DEAL10'
  assign t3_badge = section.settings.tier_3_badge | default: 'MOST SAVINGS'

  assign unit_discount_price = price | times: 100.0 | minus: t1_disc | divided_by: 100.0 | round
%}

<div class="boat-pdp-container">
  
  {% comment %} --- Top Breadcrumb Navigation --- {% endcomment %}
  <nav class="boat-pdp-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="boat-pdp-breadcrumb__sep">›</span>
    {% if collection != blank %}
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      <span class="boat-pdp-breadcrumb__sep">›</span>
    {% elsif product.collections.size > 0 %}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
      <span class="boat-pdp-breadcrumb__sep">›</span>
    {% endif %}
    {% if product.type != blank %}
      <span>{{ product.type | escape }}</span>
      <span class="boat-pdp-breadcrumb__sep">›</span>
    {% endif %}
    <span class="boat-pdp-breadcrumb__current">{{ product.title | escape }}</span>
  </nav>

  {% comment %} --- Main Product 2-Column Grid --- {% endcomment %}
  <div class="boat-pdp-layout">
    
    {% comment %} === Left Column: Media Gallery === {% endcomment %}
    <div class="boat-pdp-gallery-col">
      <div class="boat-pdp-gallery-inner">
        
        {% comment %} Left Vertical (Desktop) / Contained Smooth Slider (Mobile) Thumbnails {% endcomment %}
        {% if product.media.size > 1 %}
          <div class="boat-pdp-thumbs" id="BoatPdpThumbs">
            {% for media in product.media %}
              <button 
                type="button" 
                class="boat-pdp-thumb-btn{% if forloop.first %} active{% endif %}"
                data-media-id="{{ media.id }}"
                data-image-src="{{ media | image_url: width: 1000 }}"
                onclick="switchBoatPdpImage(this, '{{ media | image_url: width: 1000 }}')"
                aria-label="Thumbnail {{ forloop.index }}"
              >
                <img 
                  src="{{ media | image_url: width: 140, height: 140 }}" 
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="54"
                  height="54"
                >
              </button>
            {% endfor %}
          </div>
        {% endif %}

        {% comment %} Main Featured Image Display with Infinite Loop Navigation {% endcomment %}
        <div class="boat-pdp-main-image-wrapper">
          <div class="boat-pdp-main-image-box" id="BoatPdpMainImageBox">
            {% assign initial_img = selected_variant.featured_image | default: product.featured_image %}
            <img 
              id="BoatPdpMainImage"
              src="{{ initial_img | image_url: width: 1000 }}" 
              alt="{{ product.title | escape }}"
              class="boat-pdp-main-image"
              width="600"
              height="600"
            >

            {% if product.media.size > 1 %}
              <button type="button" class="boat-pdp-arrow-btn boat-pdp-arrow-btn--prev" onclick="prevBoatPdpImage()" aria-label="Previous image">‹</button>
              <button type="button" class="boat-pdp-arrow-btn boat-pdp-arrow-btn--next" onclick="nextBoatPdpImage()" aria-label="Next image">›</button>
            {% endif %}
          </div>

          {% comment %} Countdown Flash Sale Timer Bar {% endcomment %}
          {% if show_timer %}
            <div class="boat-pdp-timer-bar">
              <span class="boat-pdp-timer-icon">⏳</span>
              <span class="boat-pdp-timer-label">{{ section.settings.timer_label | default: 'Flash Sale Ends In:' }}</span>
              <span class="boat-pdp-timer-digits" id="boatPdpCountdown">04h : 02m : 19s</span>
            </div>
          {% endif %}
        </div>

      </div>
    </div>

    {% comment %} === Right Column: Product Information & Offers === {% endcomment %}
    <div class="boat-pdp-info-col">
      
      {% comment %} 1. Review Rating Badge (Unique & Dynamic per Product) {% endcomment %}
      {% if show_rating %}
        <div class="boat-pdp-rating-row">
          <span class="boat-pdp-star">★</span>
          <span class="boat-pdp-score">{{ display_rating }}</span>
          <span class="boat-pdp-count">({{ display_reviews_count }})</span>
          <span class="boat-pdp-verified-icon">✔</span>
        </div>
      {% endif %}

      {% comment %} 2. Product Title & Subtitle {% endcomment %}
      <h1 class="boat-pdp-title">{{ product.title }}</h1>
      
      <div class="boat-pdp-subtitle">
        {% if product.metafields.custom.subtitle != blank %}
          {{ product.metafields.custom.subtitle }}
        {% elsif product.description != blank %}
          {{ product.description | strip_html | truncatewords: 22 }}
        {% else %}
          Wireless Earbuds with Massive Playback of upto 40 Hours, IPX5 Water & Sweat Resistance, IWP Technology Interface
        {% endif %}
      </div>

      {% comment %} 3. Price Row {% endcomment %}
      <div class="boat-pdp-price-offer-box">
        <div class="boat-pdp-price-group">
          <div class="boat-pdp-price-main">
            <span class="boat-pdp-price" id="BoatPdpPrice">{{ price | money_without_trailing_zeros }}</span>
            <span class="boat-pdp-compare-price" id="BoatPdpCompare" style="{% unless compare_price > price %}display: none;{% endunless %}">
              {{ compare_price | money_without_trailing_zeros }}
            </span>
            <span class="boat-pdp-discount" id="BoatPdpDiscount" style="{% unless compare_price > price %}display: none;{% endunless %}">
              {{ discount_percent }}% Off
            </span>
          </div>
          <div class="boat-pdp-tax-text">MRP (Inclusive of all taxes)</div>
        </div>
      </div>

      {% comment %} --- Form for Cart Add & Dynamic Variant Selection --- {% endcomment %}
      <form action="/cart/add" method="post" id="{{ form_id }}" onsubmit="handleBoatPdpSubmit(event, this)">
        <input type="hidden" name="id" id="BoatPdpSelectedVariantId" value="{{ selected_variant.id }}">
        
        {% comment %} 4. Multi-Option Variant Selectors (Color, Quantity, Size, Pack, etc.) {% endcomment %}
        {% if product.variants.size > 1 %}
          {% for option in product.options_with_values %}
            {% assign option_index = forloop.index0 %}
            {% assign opt_name_lower = option.name | downcase %}
            {% assign is_color = false %}
            {% if opt_name_lower contains 'color' or opt_name_lower contains 'colour' or opt_name_lower contains 'shade' %}
              {% assign is_color = true %}
            {% endif %}

            <div class="boat-pdp-variant-section">
              <div class="boat-pdp-variant-label">
                Choose your {{ option.name }} : 
                <span class="boat-pdp-variant-val" id="BoatPdpOptVal-{{ option_index }}">{{ option.selected_value }}</span>
              </div>

              <div class="boat-pdp-swatches-grid">
                {% for value in option.values %}
                  {% assign swatch_variant = null %}
                  {% for variant in product.variants %}
                    {% if variant.options[option_index] == value %}
                      {% assign swatch_variant = variant %}
                      {% break %}
                    {% endif %}
                  {% endfor %}

                  {% if is_color %}
                    <button 
                      type="button" 
                      class="boat-pdp-opt-btn boat-pdp-swatch-box{% if option.selected_value == value %} active{% endif %}"
                      data-option-index="{{ option_index }}"
                      data-option-value="{{ value | escape }}"
                      onclick="handleOptionSelect(this)"
                      aria-label="{{ value | escape }}"
                    >
                      {% if swatch_variant.featured_image != blank %}
                        <img src="{{ swatch_variant.featured_image | image_url: width: 120, height: 120 }}" alt="{{ value | escape }}" loading="lazy">
                      {% else %}
                        <span>{{ value }}</span>
                      {% endif %}
                    </button>
                  {% else %}
                    <button 
                      type="button" 
                      class="boat-pdp-opt-btn boat-pdp-pill-btn{% if option.selected_value == value %} active{% endif %}"
                      data-option-index="{{ option_index }}"
                      data-option-value="{{ value | escape }}"
                      onclick="handleOptionSelect(this)"
                    >
                      <span>{{ value }}</span>
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% comment %} Quantity Stepper Selector {% endcomment %}
        <div class="boat-pdp-qty-wrapper">
          <span class="boat-pdp-qty-label">Quantity :</span>
          <div class="boat-pdp-qty-stepper">
            <button type="button" class="boat-pdp-qty-btn" onclick="changePdpQty(-1)" aria-label="Decrease quantity">−</button>
            <input type="number" id="BoatPdpQuantity" name="quantity" value="1" min="1" class="boat-pdp-qty-input" readonly>
            <button type="button" class="boat-pdp-qty-btn" onclick="changePdpQty(1)" aria-label="Increase quantity">+</button>
          </div>
        </div>

        {% comment %} Dynamic Real-Time Subtotal Row with Discount Tag {% endcomment %}
        <div class="boat-pdp-subtotal-wrapper">
          <div class="boat-pdp-subtotal-left">
            <span class="boat-pdp-subtotal-label">Subtotal :</span>
            <span class="boat-pdp-subtotal-val" id="BoatPdpSubtotal">{{ price | money_without_trailing_zeros }}</span>
            <span class="boat-pdp-subtotal-compare" id="BoatPdpSubtotalCompare" style="display: none;"></span>
          </div>
          <span class="boat-pdp-subtotal-discount-tag" id="BoatPdpSubtotalDiscountTag" style="display: none;"></span>
        </div>

        {% comment %} 5. Dynamic DEAL Section {% endcomment %}
        {% if show_deal %}
          <div class="boat-pdp-offers-section">
            <div class="boat-pdp-card-title">{{ section.settings.deal_title | default: '🔥 DEAL' }}</div>
            <div class="boat-pdp-offers-grid">
              
              <div class="boat-pdp-offer-card" id="BoatDealCard-{{ t1_qty }}" onclick="applyBoatDeal({{ t1_qty }}, {{ t1_disc }}, '{{ t1_code }}', this)">
                <div class="boat-pdp-offer-badge">{{ t1_badge }}</div>
                <div class="boat-pdp-offer-inner">
                  <div class="boat-pdp-offer-qty">Buy {{ t1_qty }} or more</div>
                  <div class="boat-pdp-offer-disc">Get {{ t1_disc }}% Off</div>
                  <div class="boat-pdp-offer-code">Code: <strong>{{ t1_code }}</strong></div>
                </div>
              </div>

              <div class="boat-pdp-offer-card" id="BoatDealCard-{{ t2_qty }}" onclick="applyBoatDeal({{ t2_qty }}, {{ t2_disc }}, '{{ t2_code }}', this)">
                <div class="boat-pdp-offer-badge">{{ t2_badge }}</div>
                <div class="boat-pdp-offer-inner">
                  <div class="boat-pdp-offer-qty">Buy {{ t2_qty }} or more</div>
                  <div class="boat-pdp-offer-disc">Get {{ t2_disc }}% Off</div>
                  <div class="boat-pdp-offer-code">Code: <strong>{{ t2_code }}</strong></div>
                </div>
              </div>

              <div class="boat-pdp-offer-card" id="BoatDealCard-{{ t3_qty }}" onclick="applyBoatDeal({{ t3_qty }}, {{ t3_disc }}, '{{ t3_code }}', this)">
                <div class="boat-pdp-offer-badge">{{ t3_badge }}</div>
                <div class="boat-pdp-offer-inner">
                  <div class="boat-pdp-offer-qty">Buy {{ t3_qty }} or more</div>
                  <div class="boat-pdp-offer-disc">Get {{ t3_disc }}% Off</div>
                  <div class="boat-pdp-offer-code">Code: <strong>{{ t3_code }}</strong></div>
                </div>
              </div>

            </div>
          </div>
        {% endif %}

        {% comment %} 6. Action Buttons (Add to Cart + Buy Now + WhatsApp) {% endcomment %}
        <div class="boat-pdp-cta-group{% if hide_inline_buttons_mobile %} boat-pdp-cta-group--hide-mobile{% endif %}">
          <button 
            type="submit" 
            class="boat-pdp-btn boat-pdp-btn--atc" 
            id="BoatPdpAtcBtn"
            {% unless selected_variant.available %}disabled{% endunless %}
          >
            {% if selected_variant.available %}
              <span>Add to Cart</span>
            {% else %}
              <span>Sold Out</span>
            {% endif %}
          </button>
          
          <button 
            type="button" 
            class="boat-pdp-btn boat-pdp-btn--buy" 
            id="BoatPdpBuyBtn"
            onclick="buyNowBoatPdp('{{ form_id }}')"
            {% unless selected_variant.available %}disabled{% endunless %}
          >
            <span>Buy Now</span>
          </button>
        </div>

        {% comment %} Direct WhatsApp Order Button {% endcomment %}
        {% if section.settings.enable_whatsapp_order == nil or section.settings.enable_whatsapp_order == true %}
          <div class="boat-pdp-whatsapp-row{% if hide_inline_buttons_mobile %} boat-pdp-cta-group--hide-mobile{% endif %}">
            <button 
              type="button" 
              class="boat-pdp-btn boat-pdp-btn--whatsapp" 
              id="BoatPdpWhatsappBtn"
              onclick="orderBoatOnWhatsapp()"
              style="{% if section.settings.whatsapp_btn_bg != blank %}background: {{ section.settings.whatsapp_btn_bg }};{% endif %}"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.761.881 2.796.881 3.179 0 5.766-2.587 5.767-5.766.001-3.181-2.585-5.768-5.767-5.768zm0-2.172c4.418 0 8 3.582 8 8 0 4.418-3.582 8-8 8-1.408 0-2.73-.367-3.875-1.009l-4.156 1.009 1.109-3.992c-.696-1.164-1.078-2.525-1.078-4.008 0-4.418 3.582-8 8-8z"/>
              </svg>
              <span>{{ section.settings.whatsapp_btn_label | default: 'Order via WhatsApp' }}</span>
            </button>
          </div>
        {% endif %}

      </form>

    </div>

  </div>

  {% comment %} --- boAt Style Tab Navigation Bar (Overview, Specs, FAQs, Reviews) --- {% endcomment %}
  {% if enable_pdp_tabs and show_tab_overview or show_tab_specs or show_tab_faqs or show_tab_reviews %}
    {% assign first_active_tab = '' %}
    {% if show_tab_overview %}
      {% assign first_active_tab = 'overview' %}
    {% elsif show_tab_specs %}
      {% assign first_active_tab = 'specs' %}
    {% elsif show_tab_faqs %}
      {% assign first_active_tab = 'faqs' %}
    {% elsif show_tab_reviews %}
      {% assign first_active_tab = 'reviews' %}
    {% endif %}

    <div class="boat-pdp-nav-sticky-wrapper" id="BoatPdpNavStickyWrapper">
      <div class="boat-pdp-nav-pill-bar" id="BoatPdpNavPillBar">
        {% if show_tab_overview %}
          <button type="button" class="boat-nav-pill{% if first_active_tab == 'overview' %} active{% endif %}" onclick="switchBoatTab('overview', this)">
            <span>Overview</span>
          </button>
        {% endif %}

        {% if show_tab_specs %}
          <button type="button" class="boat-nav-pill{% if first_active_tab == 'specs' %} active{% endif %}" onclick="switchBoatTab('specs', this)">
            <span>Specs</span>
          </button>
        {% endif %}

        {% if show_tab_faqs %}
          <button type="button" class="boat-nav-pill{% if first_active_tab == 'faqs' %} active{% endif %}" onclick="switchBoatTab('faqs', this)">
            <span>FAQ's</span>
          </button>
        {% endif %}

        {% if show_tab_reviews %}
          <button type="button" class="boat-nav-pill{% if first_active_tab == 'reviews' %} active{% endif %}" onclick="switchBoatTab('reviews', this)">
            <span>Reviews</span>
          </button>
        {% endif %}
      </div>
    </div>

    {% comment %} --- Dynamic Product Tabs Content Panels (Tab Switching) --- {% endcomment %}
    <div class="boat-pdp-tabs-content">

      {% comment %} Tab 1: Overview {% endcomment %}
      {% if show_tab_overview %}
        <section class="boat-tab-section{% if first_active_tab == 'overview' %} active{% endif %}" id="boat-tab-overview">
          <div class="boat-tab-section__header">
            <h2 class="boat-tab-section__title">Product Overview & Features</h2>
            <p class="boat-tab-section__subtitle">Explore everything that makes {{ product.title }} special</p>
          </div>
          
          <div class="boat-tab-overview-grid">
            <div class="boat-tab-feature-card">
              <div class="boat-feature-icon">⚡</div>
              <h3 class="boat-feature-title">Premium Performance</h3>
              <p class="boat-feature-desc">Engineered for exceptional reliability, durability and effortless everyday use.</p>
            </div>
            <div class="boat-tab-feature-card">
              <div class="boat-feature-icon">🛡️</div>
              <h3 class="boat-feature-title">100% Original & Verified</h3>
              <p class="boat-feature-desc">Guaranteed authentic product backed by strict quality control standards.</p>
            </div>
            <div class="boat-tab-feature-card">
              <div class="boat-feature-icon">🚚</div>
              <h3 class="boat-feature-title">Fast Express Delivery</h3>
              <p class="boat-feature-desc">Quick doorstep dispatch with real-time tracking and Cash on Delivery available.</p>
            </div>
            <div class="boat-tab-feature-card">
              <div class="boat-feature-icon">💎</div>
              <h3 class="boat-feature-title">Superior Build Quality</h3>
              <p class="boat-feature-desc">Crafted with high-grade, durable materials built to last long.</p>
            </div>
          </div>

          {% if product.description != blank %}
            <div class="boat-tab-description-box">
              <h3 class="boat-desc-heading">Detailed Description</h3>
              <div class="boat-rte-content">
                {{ product.description }}
              </div>
            </div>
          {% endif %}
        </section>
      {% endif %}

      {% comment %} Tab 2: Specs (Filtered out default title) {% endcomment %}
      {% if show_tab_specs %}
        <section class="boat-tab-section{% if first_active_tab == 'specs' %} active{% endif %}" id="boat-tab-specs">
          <div class="boat-tab-section__header">
            <h2 class="boat-tab-section__title">Technical Specifications</h2>
            <p class="boat-tab-section__subtitle">Complete details and technical parameters</p>
          </div>

          <div class="boat-tab-specs-table-card">
            <div class="boat-spec-row">
              <span class="boat-spec-name">Product Name</span>
              <span class="boat-spec-val">{{ product.title }}</span>
            </div>
            {% if product.vendor != blank and product.vendor != 'vendor-unknown' %}
              <div class="boat-spec-row">
                <span class="boat-spec-name">Brand / Vendor</span>
                <span class="boat-spec-val">{{ product.vendor }}</span>
              </div>
            {% endif %}
            {% if product.type != blank %}
              <div class="boat-spec-row">
                <span class="boat-spec-name">Category / Type</span>
                <span class="boat-spec-val">{{ product.type }}</span>
              </div>
            {% elsif product.collections.size > 0 %}
              <div class="boat-spec-row">
                <span class="boat-spec-name">Category</span>
                <span class="boat-spec-val">{{ product.collections.first.title }}</span>
              </div>
            {% endif %}
            {% if selected_variant.sku != blank %}
              <div class="boat-spec-row">
                <span class="boat-spec-name">SKU / Model Number</span>
                <span class="boat-spec-val">{{ selected_variant.sku }}</span>
              </div>
            {% endif %}
            {% if selected_variant.barcode != blank %}
              <div class="boat-spec-row">
                <span class="boat-spec-name">Barcode / UPC</span>
                <span class="boat-spec-val">{{ selected_variant.barcode }}</span>
              </div>
            {% endif %}
            {% if selected_variant.weight > 0 %}
              <div class="boat-spec-row">
                <span class="boat-spec-name">Product Weight</span>
                <span class="boat-spec-val">{{ selected_variant.weight | weight_with_unit }}</span>
              </div>
            {% endif %}
            {% unless product.has_only_default_variant %}
              {% for option in product.options_with_values %}
                {% unless option.name == 'Title' and option.values.first == 'Default Title' %}
                  <div class="boat-spec-row">
                    <span class="boat-spec-name">Available {{ option.name }}</span>
                    <span class="boat-spec-val">
                      {% for val in option.values %}
                        {{ val }}{% unless forloop.last %}, {% endunless %}
                      {% endfor %}
                    </span>
                  </div>
                {% endunless %}
              {% endfor %}
            {% endunless %}
            <div class="boat-spec-row">
              <span class="boat-spec-name">Quality Standard</span>
              <span class="boat-spec-val">100% Brand New, Tested & Quality Checked</span>
            </div>
            <div class="boat-spec-row">
              <span class="boat-spec-name">Delivery Speed</span>
              <span class="boat-spec-val">2 to 4 Business Days Across Pakistan</span>
            </div>
            <div class="boat-spec-row">
              <span class="boat-spec-name">Payment Options</span>
              <span class="boat-spec-val">Cash on Delivery (COD) / Bank Transfer</span>
            </div>
            <div class="boat-spec-row">
              <span class="boat-spec-name">Warranty / Guarantee</span>
              <span class="boat-spec-val">7-Day Replacement Guarantee</span>
            </div>
            <div class="boat-spec-row">
              <span class="boat-spec-name">Package Contents</span>
              <span class="boat-spec-val">1x {{ product.title }} in Secure Packing</span>
            </div>
          </div>
        </section>
      {% endif %}

      {% comment %} Tab 3: FAQ's (Dynamic Blocks with Fallback Defaults) {% endcomment %}
      {% if show_tab_faqs %}
        <section class="boat-tab-section{% if first_active_tab == 'faqs' %} active{% endif %}" id="boat-tab-faqs">
          <div class="boat-tab-section__header">
            <h2 class="boat-tab-section__title">Frequently Asked Questions</h2>
            <p class="boat-tab-section__subtitle">Got questions? We've got answers for you</p>
          </div>

          <div class="boat-faqs-accordion">
            {% assign faq_block_count = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'faq' %}
                {% assign faq_block_count = faq_block_count | plus: 1 %}
                <div class="boat-faq-item" {{ block.shopify_attributes }} onclick="toggleBoatFaq(this)">
                  <div class="boat-faq-question">
                    <span>{{ block.settings.question }}</span>
                    <span class="boat-faq-arrow">▾</span>
                  </div>
                  <div class="boat-faq-answer">
                    <p>{{ block.settings.answer }}</p>
                  </div>
                </div>
              {% endif %}
            {% endfor %}

            {% if faq_block_count == 0 %}
              <div class="boat-faq-item" onclick="toggleBoatFaq(this)">
                <div class="boat-faq-question">
                  <span>What is the estimated delivery time for my order?</span>
                  <span class="boat-faq-arrow">▾</span>
                </div>
                <div class="boat-faq-answer">
                  <p>Orders are dispatched within 24 hours. Delivery typically takes 2 to 4 business days across all major cities in Pakistan with active tracking updates.</p>
                </div>
              </div>

              <div class="boat-faq-item" onclick="toggleBoatFaq(this)">
                <div class="boat-faq-question">
                  <span>Is Cash on Delivery (COD) available?</span>
                  <span class="boat-faq-arrow">▾</span>
                </div>
                <div class="boat-faq-answer">
                  <p>Yes! We offer 100% Cash on Delivery across Pakistan. You can pay conveniently when the parcel arrives at your doorstep.</p>
                </div>
              </div>

              <div class="boat-faq-item" onclick="toggleBoatFaq(this)">
                <div class="boat-faq-question">
                  <span>What if I receive a damaged or wrong product?</span>
                  <span class="boat-faq-arrow">▾</span>
                </div>
                <div class="boat-faq-answer">
                  <p>We provide a hassle-free 7-day replacement guarantee. Simply contact our support on WhatsApp at +92 310 2492119 and we will swiftly arrange a replacement for you.</p>
                </div>
              </div>

              <div class="boat-faq-item" onclick="toggleBoatFaq(this)">
                <div class="boat-faq-question">
                  <span>How can I place an order directly on WhatsApp?</span>
                  <span class="boat-faq-arrow">▾</span>
                </div>
                <div class="boat-faq-answer">
                  <p>You can click the green "Order via WhatsApp" button on this product page. It will automatically generate a message with the product name and price for instant confirmation.</p>
                </div>
              </div>
            {% endif %}
          </div>
        </section>
      {% endif %}

      {% comment %} Tab 4: Reviews {% endcomment %}
      {% if show_tab_reviews %}
        <section class="boat-tab-section{% if first_active_tab == 'reviews' %} active{% endif %}" id="boat-tab-reviews">
          <div class="boat-tab-section__header">
            <div class="boat-reviews-header-flex">
              <div>
                <h2 class="boat-tab-section__title">Customer Reviews & Ratings</h2>
                <p class="boat-tab-section__subtitle">Verified feedback from real customers</p>
              </div>
              <button type="button" class="boat-write-review-btn" onclick="toggleBoatReviewForm()">
                <span>✍️ Write a Review</span>
              </button>
            </div>
          </div>

          <div class="boat-reviews-summary-card">
            <div class="boat-reviews-score-box">
              <div class="boat-reviews-score-big">{{ display_rating }}</div>
              <div class="boat-reviews-stars">★★★★★</div>
              <div class="boat-reviews-count-text">Based on {{ display_reviews_count }} Verified Reviews</div>
            </div>

            <div class="boat-reviews-breakdown">
              <div class="boat-rating-bar-row">
                <span>5 Star</span>
                <div class="boat-rating-progress"><div class="boat-rating-fill" style="width: 88%;"></div></div>
                <span>88%</span>
              </div>
              <div class="boat-rating-bar-row">
                <span>4 Star</span>
                <div class="boat-rating-progress"><div class="boat-rating-fill" style="width: 9%;"></div></div>
                <span>9%</span>
              </div>
              <div class="boat-rating-bar-row">
                <span>3 Star</span>
                <div class="boat-rating-progress"><div class="boat-rating-fill" style="width: 3%;"></div></div>
                <span>3%</span>
              </div>
              <div class="boat-rating-bar-row">
                <span>2 Star</span>
                <div class="boat-rating-progress"><div class="boat-rating-fill" style="width: 0%;"></div></div>
                <span>0%</span>
              </div>
              <div class="boat-rating-bar-row">
                <span>1 Star</span>
                <div class="boat-rating-progress"><div class="boat-rating-fill" style="width: 0%;"></div></div>
                <span>0%</span>
              </div>
            </div>
          </div>

          {% comment %} Interactive Review Submission Form {% endcomment %}
          <div class="boat-review-form-wrapper" id="BoatReviewFormWrapper" style="display: none;">
            <form class="boat-review-form" onsubmit="handleBoatReviewSubmit(event, this)">
              <h3 class="boat-form-title">Write your review for {{ product.title }}</h3>
              
              <div class="boat-form-row">
                <label class="boat-form-label">Rating</label>
                <div class="boat-form-star-select">
                  <span class="boat-star-option" onclick="setBoatFormRating(1, this)">★</span>
                  <span class="boat-star-option" onclick="setBoatFormRating(2, this)">★</span>
                  <span class="boat-star-option" onclick="setBoatFormRating(3, this)">★</span>
                  <span class="boat-star-option" onclick="setBoatFormRating(4, this)">★</span>
                  <span class="boat-star-option active" onclick="setBoatFormRating(5, this)">★</span>
                </div>
                <input type="hidden" name="rating" id="BoatFormRatingVal" value="5">
              </div>

              <div class="boat-form-grid">
                <div class="boat-form-field">
                  <label class="boat-form-label">Your Name *</label>
                  <input type="text" class="boat-form-input" placeholder="e.g. Ali Ahmed" required>
                </div>
                <div class="boat-form-field">
                  <label class="boat-form-label">Your Phone / Email *</label>
                  <input type="text" class="boat-form-input" placeholder="e.g. 0310-XXXXXXX" required>
                </div>
              </div>

              <div class="boat-form-field">
                <label class="boat-form-label">Your Review *</label>
                <textarea class="boat-form-textarea" rows="3" placeholder="Share your experience with this product..." required></textarea>
              </div>

              <button type="submit" class="boat-form-submit-btn">
                <span>Submit Review</span>
              </button>
              <div class="boat-review-success-msg" id="BoatReviewSuccessMsg" style="display: none;">
                ✓ Thank you! Your review has been submitted and will appear after verification.
              </div>
            </form>
          </div>

          {% comment %} Shopify Product Review App Container Hook {% endcomment %}
          <div id="shopify-product-reviews" data-id="{{ product.id }}">
            {{ product.metafields.spr.reviews }}
          </div>
        </section>
      {% endif %}

    </div>
  {% endif %}

</div>

{% comment %} Mobile Floating Sticky Bottom Bar (Matching Exact Screenshot UI) {% endcomment %}
{% if show_mobile_sticky %}
  <div class="boat-pdp-sticky-bar" id="BoatPdpStickyBar">
    {% if show_sticky_deal_strip %}
      <div class="boat-pdp-sticky-deal-strip" id="BoatPdpStickyDealStrip" onclick="scrollToBoatDeals()">
        {% if show_deal %}
          Get at <span id="BoatPdpStickyDealPrice">{{ price | money_without_trailing_zeros }}</span> by using <strong id="BoatPdpStickyDealCode">{{ t1_code }}</strong>
        {% elsif discount_percent > 0 %}
          🔥 Special Sale Price: {{ price | money_without_trailing_zeros }} (Save {{ discount_percent }}%)
        {% else %}
          ⚡ Best Price: {{ price | money_without_trailing_zeros }}
        {% endif %}
      </div>
    {% endif %}
    <div class="boat-pdp-sticky-inner">
      <div class="boat-pdp-sticky-price-row">
        <span class="boat-pdp-sticky-price" id="BoatPdpStickyPrice">{{ price | money_without_trailing_zeros }}</span>
        <span class="boat-pdp-sticky-compare" id="BoatPdpStickyCompare" style="{% unless compare_price > price %}display: none;{% endunless %}">
          {{ compare_price | money_without_trailing_zeros }}
        </span>
        <span class="boat-pdp-sticky-discount" id="BoatPdpStickyDiscount" style="{% unless compare_price > price %}display: none;{% endunless %}">
          {{ discount_percent }}% Off
        </span>
        <span class="boat-pdp-sticky-tax">Inclusive of all Taxes</span>
      </div>
      <div class="boat-pdp-sticky-cta-row">
        <button 
          type="button" 
          class="boat-pdp-sticky-btn boat-pdp-sticky-btn--atc" 
          onclick="document.getElementById('BoatPdpAtcBtn').click()"
          {% unless selected_variant.available %}disabled{% endunless %}
        >
          <span>{{ section.settings.sticky_atc_text | default: 'Add To Cart' }}</span>
        </button>
        <button 
          type="button" 
          class="boat-pdp-sticky-btn boat-pdp-sticky-btn--buy" 
          onclick="document.getElementById('BoatPdpBuyBtn').click()"
          {% unless selected_variant.available %}disabled{% endunless %}
        >
          <span>{{ section.settings.sticky_buy_text | default: 'Buy Now' }}</span>
        </button>
        <button 
          type="button" 
          class="boat-pdp-sticky-btn boat-pdp-sticky-btn--whatsapp" 
          onclick="orderBoatOnWhatsapp()"
          aria-label="Order on WhatsApp"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.761.881 2.796.881 3.179 0 5.766-2.587 5.767-5.766.001-3.181-2.585-5.768-5.767-5.768zm0-2.172c4.418 0 8 3.582 8 8 0 4.418-3.582 8-8 8-1.408 0-2.73-.367-3.875-1.009l-4.156 1.009 1.109-3.992c-.696-1.164-1.078-2.525-1.078-4.008 0-4.418 3.582-8 8-8z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
{% endif %}

{% comment %} Desktop Floating Sticky Pill Bar (Matching Exact Screenshot UI from Ronin/boAt) {% endcomment %}
{% if enable_desktop_sticky %}
  <div class="boat-pdp-desktop-sticky-bar" id="BoatPdpDesktopStickyBar">
    <div class="boat-desktop-sticky-pill">
      {% if featured_img != blank %}
        <img class="boat-desktop-sticky-img" id="BoatDesktopStickyImg" src="{{ featured_img | image_url: width: 140 }}" alt="{{ product.title | escape }}">
      {% elsif product.featured_image != blank %}
        <img class="boat-desktop-sticky-img" id="BoatDesktopStickyImg" src="{{ product.featured_image | image_url: width: 140 }}" alt="{{ product.title | escape }}">
      {% elsif product.media.first != blank %}
        <img class="boat-desktop-sticky-img" id="BoatDesktopStickyImg" src="{{ product.media.first | image_url: width: 140 }}" alt="{{ product.title | escape }}">
      {% endif %}
      
      <div class="boat-desktop-sticky-info">
        <span class="boat-desktop-sticky-title">{{ product.title }}</span>
        <div class="boat-desktop-sticky-pricing">
          <span class="boat-desktop-sticky-price" id="BoatDesktopStickyPrice">{{ price | money_without_trailing_zeros }}</span>
          <span class="boat-desktop-sticky-compare" id="BoatDesktopStickyCompare" style="{% unless compare_price > price %}display: none;{% endunless %}">
            {{ compare_price | money_without_trailing_zeros }}
          </span>
        </div>
      </div>

      <button type="button" class="boat-desktop-sticky-btn" onclick="triggerBoatDesktopAtc()" {% unless selected_variant.available %}disabled{% endunless %}>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span>Add to cart</span>
      </button>
    </div>
  </div>
{% endif %}

{% comment %} Output Master Product Variants JSON {% endcomment %}
<script type="application/json" id="BoatPdpVariantsData">
  [
    {% for v in product.variants %}
      {
        "id": {{ v.id }},
        "title": {{ v.title | json }},
        "option1": {{ v.option1 | json }},
        "option2": {{ v.option2 | json }},
        "option3": {{ v.option3 | json }},
        "price": {{ v.price }},
        "compare_at_price": {{ v.compare_at_price | default: 0 }},
        "available": {{ v.available }},
        "featured_image": {% if v.featured_image != blank %}{{ v.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
</script>

<style>
  /* ------------------------------------------------------------- */
  /* boAt Authentic Product Page Styling (100% Mobile Responsive)  */
  /* ------------------------------------------------------------- */

  :root {
    --boat-pdp-title-size: {{ section.settings.title_font_size | default: 28 }}px;
    --boat-pdp-title-color: {{ section.settings.title_color | default: '#0f172a' }};
    --boat-pdp-price-color: {{ section.settings.price_color | default: '#0f172a' }};
    --boat-pdp-discount-color: {{ section.settings.discount_color | default: '#00b853' }};
    --boat-pdp-atc-bg: {{ section.settings.atc_btn_bg | default: '#0f172a' }};
    --boat-pdp-atc-text: {{ section.settings.atc_btn_text | default: '#ffffff' }};
    --boat-pdp-buy-bg: {{ section.settings.buy_btn_bg | default: '#00b853' }};
    --boat-pdp-buy-text: {{ section.settings.buy_btn_text | default: '#ffffff' }};
    --boat-pdp-sticky-strip-bg: {{ section.settings.sticky_strip_bg | default: '#00875a' }};
    --boat-pdp-sticky-strip-text: {{ section.settings.sticky_strip_text | default: '#ffffff' }};
    --boat-pdp-sticky-atc-bg: {{ section.settings.sticky_atc_bg | default: '#0f172a' }};
    --boat-pdp-sticky-atc-text: {{ section.settings.sticky_atc_text_color | default: '#ffffff' }};
    --boat-pdp-sticky-buy-bg: {{ section.settings.sticky_buy_bg | default: '#00b853' }};
    --boat-pdp-sticky-buy-text: {{ section.settings.sticky_buy_text_color | default: '#ffffff' }};
  }

  .boat-pdp-container {
    max-width: 1320px;
    width: 100%;
    margin: 0 auto;
    padding: 16px 20px 48px 20px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  /* Breadcrumb */
  .boat-pdp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #64748b;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .boat-pdp-breadcrumb a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .boat-pdp-breadcrumb a:hover {
    color: #0f172a;
    text-decoration: underline;
  }

  .boat-pdp-breadcrumb__sep {
    color: #94a3b8;
    font-size: 0.85rem;
  }

  .boat-pdp-breadcrumb__current {
    color: #0f172a;
    font-weight: 700;
  }

  /* 2-Column Layout */
  .boat-pdp-layout {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
    align-items: start;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Gallery Column & Inner */
  .boat-pdp-gallery-col {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .boat-pdp-gallery-inner {
    display: flex;
    gap: 16px;
    position: sticky;
    top: 90px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Vertical Thumbnails (Desktop) */
  .boat-pdp-thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 68px;
    flex-shrink: 0;
    max-height: 520px;
    overflow-y: auto;
    scrollbar-width: none;
    box-sizing: border-box;
  }

  .boat-pdp-thumbs::-webkit-scrollbar {
    display: none;
  }

  .boat-pdp-thumb-btn {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    border: 1.5px solid #e2e8f0;
    background: #ffffff;
    padding: 2px;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .boat-pdp-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .boat-pdp-thumb-btn:hover,
  .boat-pdp-thumb-btn.active {
    border-color: #0f172a;
    box-shadow: 0 0 0 1px #0f172a;
  }

  /* Main Featured Image Box */
  .boat-pdp-main-image-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-pdp-main-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #f1f5f9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    touch-action: pan-y;
    box-sizing: border-box;
  }

  .boat-pdp-main-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .boat-pdp-arrow-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #0f172a;
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    cursor: pointer;
    opacity: 0.85;
    transition: all 0.2s ease;
    z-index: 5;
  }

  .boat-pdp-arrow-btn:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.08);
  }

  .boat-pdp-arrow-btn--prev { left: 10px; }
  .boat-pdp-arrow-btn--next { right: 10px; }

  /* Flash Sale Countdown Timer Bar */
  .boat-pdp-timer-bar {
    background: #fff9db;
    border: 1px solid #ffe066;
    border-radius: 12px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
    box-sizing: border-box;
  }

  .boat-pdp-timer-digits {
    color: #d8232a;
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.5px;
  }

  /* Right Information Column */
  .boat-pdp-info-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Rating Row */
  .boat-pdp-rating-row {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
  }

  .boat-pdp-star { color: #f59e0b; font-size: 1rem; }
  .boat-pdp-score { color: #0f172a; font-weight: 800; font-size: 0.9rem; }
  .boat-pdp-count { color: #64748b; font-weight: 600; font-size: 0.8rem; }
  .boat-pdp-verified-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #10b981;
    color: #ffffff;
    font-size: 9px;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    margin-left: 2px;
  }

  /* Title & Subtitle */
  .boat-pdp-title {
    font-size: var(--boat-pdp-title-size);
    font-weight: 900;
    color: var(--boat-pdp-title-color);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.5px;
    word-break: break-word;
  }

  .boat-pdp-subtitle {
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.45;
    font-weight: 500;
  }

  /* Price Row */
  .boat-pdp-price-offer-box {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
    box-sizing: border-box;
  }

  .boat-pdp-price-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .boat-pdp-price {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--boat-pdp-price-color);
  }

  .boat-pdp-compare-price {
    font-size: 0.95rem;
    text-decoration: line-through;
    color: #94a3b8;
    font-weight: 500;
  }

  .boat-pdp-discount {
    font-size: 0.95rem;
    font-weight: 800;
