<script>
  // WhatsApp Order Direct Handler
  function orderBoatOnWhatsapp() {
    const phone = '923102492119';
    const title = {{ product.title | json }};
    const priceElem = document.getElementById('BoatPdpPrice') || document.getElementById('BoatPdpStickyPrice');
    const price = priceElem ? priceElem.innerText.trim() : '{{ price | money_without_trailing_zeros }}';
    const url = window.location.href;

    let msg = `Hello DealBazaar! I want to order this product:\n\n`;
    msg += `📌 *Product:* ${title}\n`;
    msg += `💰 *Price:* ${price}\n`;
    msg += `🔗 *Link:* ${url}\n\n`;
    msg += `Please confirm my order. Thank you!`;

    const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
    window.open(waUrl, '_blank');
  }

  // Image Thumbnail Switcher with Smooth Center Scrolling
  function switchBoatPdpImage(btn, imgSrc) {
    const mainImg = document.getElementById('BoatPdpMainImage');
    if (mainImg && imgSrc) {
      mainImg.style.opacity = '0.35';
      mainImg.style.transform = 'scale(0.98)';
      setTimeout(() => {
        mainImg.src = imgSrc;
        mainImg.style.opacity = '1';
        mainImg.style.transform = 'scale(1)';
      }, 120);
    }

    const allThumbs = document.querySelectorAll('.boat-pdp-thumb-btn');
    allThumbs.forEach(t => t.classList.remove('active'));
    btn.classList.add('active');

    // Smooth scroll thumbnail into center of slider
    if (typeof btn.scrollIntoView === 'function') {
      btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }
  }

  // Infinite Loop Previous & Next Arrow Handlers
  function prevBoatPdpImage() {
    const allThumbs = Array.from(document.querySelectorAll('.boat-pdp-thumb-btn'));
    if (allThumbs.length <= 1) return;
    const activeIdx = allThumbs.findIndex(t => t.classList.contains('active'));
    const nextIdx = (activeIdx - 1 + allThumbs.length) % allThumbs.length;
    allThumbs[nextIdx].click();
  }

  function nextBoatPdpImage() {
    const allThumbs = Array.from(document.querySelectorAll('.boat-pdp-thumb-btn'));
    if (allThumbs.length <= 1) return;
    const activeIdx = allThumbs.findIndex(t => t.classList.contains('active'));
    const nextIdx = (activeIdx + 1) % allThumbs.length;
    allThumbs[nextIdx].click();
  }

  // Touch Swipe on Main Image Box for Mobile
  (function() {
    const box = document.getElementById('BoatPdpMainImageBox');
    if (!box) return;
    let touchStartX = 0;
    let touchEndX = 0;

    box.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    box.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeDistance = touchEndX - touchStartX;
      if (Math.abs(swipeDistance) > 40) {
        if (swipeDistance < 0) {
          nextBoatPdpImage(); // Swiped left -> next
        } else {
          prevBoatPdpImage(); // Swiped right -> prev
        }
      }
    }
  })();

  // Live Flash Sale Countdown Timer
  (function() {
    let totalSeconds = {{ section.settings.timer_hours | default: 4 }} * 3600 + {{ section.settings.timer_minutes | default: 2 }} * 60 + 19;
    const timerElem = document.getElementById('boatPdpCountdown');
    if (!timerElem) return;

    setInterval(() => {
      if (totalSeconds > 0) totalSeconds--;
      const hours = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
      const minutes = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
      const seconds = String(totalSeconds % 60).padStart(2, '0');
      timerElem.textContent = `${hours}h : ${minutes}m : ${seconds}s`;
    }, 1000);
  })();

  // Master Variant Resolver & Multi-Option Matching
  const variantsData = JSON.parse(document.getElementById('BoatPdpVariantsData').textContent);
  let currentVariantPrice = {{ selected_variant.price }};
  let currentVariantComparePrice = {{ selected_variant.compare_at_price | default: 0 }};
  let currentVariantDiscountPercent = {{ discount_percent }};
  let activeCouponCode = '';

  const tierConfig = {
    t1_qty: {{ t1_qty }},
    t1_disc: {{ t1_disc }},
    t1_code: {{ t1_code | json }},
    t2_qty: {{ t2_qty }},
    t2_disc: {{ t2_disc }},
    t2_code: {{ t2_code | json }},
    t3_qty: {{ t3_qty }},
    t3_disc: {{ t3_disc }},
    t3_code: {{ t3_code | json }}
  };

  let selectedOptions = [
    {% for option in product.options_with_values %}
      {{ option.selected_value | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  function formatMoneyWithoutDecimals(cents) {
    const amount = Math.floor(cents / 100);
    return 'Rs.' + amount.toLocaleString();
  }

  const isDealsEnabledOnProduct = {{ show_deal | json }};

  function scrollToBoatDeals() {
    const dealSec = document.querySelector('.boat-pdp-offers-section');
    if (dealSec) {
      dealSec.scrollIntoView({ behavior: 'smooth', block: 'center' });
      dealSec.style.transition = 'all 0.3s ease';
      dealSec.style.boxShadow = '0 0 0 3px #00a651';
      dealSec.style.borderRadius = '14px';
      setTimeout(() => { dealSec.style.boxShadow = ''; }, 1500);
    }
  }

  // Dynamic Subtotal Calculator with Automatic Tier Discounts and Sticky Bar Sync
  function updateBoatSubtotal() {
    const qtyInput = document.getElementById('BoatPdpQuantity');
    const qty = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;
    const originalCents = currentVariantPrice * qty;

    let discountPercent = 0;
    let activeCode = '';

    if (qty >= tierConfig.t3_qty) {
      discountPercent = tierConfig.t3_disc;
      activeCode = tierConfig.t3_code;
    } else if (qty >= tierConfig.t2_qty) {
      discountPercent = tierConfig.t2_disc;
      activeCode = tierConfig.t2_code;
    } else if (qty >= tierConfig.t1_qty) {
      discountPercent = tierConfig.t1_disc;
      activeCode = tierConfig.t1_code;
    }

    activeCouponCode = activeCode;
    window.activePdpDiscountCode = activeCode;

    const discountedCents = Math.round(originalCents * (1 - (discountPercent / 100)));

    const subtotalElem = document.getElementById('BoatPdpSubtotal');
    const compareElem = document.getElementById('BoatPdpSubtotalCompare');
    const discountTag = document.getElementById('BoatPdpSubtotalDiscountTag');

    // Sticky bar elements
    const stickyPrice = document.getElementById('BoatPdpStickyPrice');
    const stickyCompare = document.getElementById('BoatPdpStickyCompare');
    const stickyDisc = document.getElementById('BoatPdpStickyDiscount');
    const stickyDealStrip = document.getElementById('BoatPdpStickyDealStrip');
    const deskStickyPrice = document.getElementById('BoatDesktopStickyPrice');
    const deskStickyCompare = document.getElementById('BoatDesktopStickyCompare');

    if (discountPercent > 0) {
      if (subtotalElem) subtotalElem.textContent = formatMoneyWithoutDecimals(discountedCents);
      if (compareElem) {
        compareElem.textContent = formatMoneyWithoutDecimals(originalCents);
        compareElem.style.display = 'inline';
      }
      if (discountTag) {
        discountTag.textContent = discountPercent + '% OFF (' + activeCode + ')';
        discountTag.style.display = 'inline-flex';
      }

      // Sticky bar shows discounted subtotal & crossed original amount
      if (stickyPrice) stickyPrice.textContent = formatMoneyWithoutDecimals(discountedCents);
      if (stickyCompare) {
        stickyCompare.textContent = formatMoneyWithoutDecimals(originalCents);
        stickyCompare.style.display = 'inline';
      }
      if (stickyDisc) {
        stickyDisc.textContent = discountPercent + '% Off';
        stickyDisc.style.display = 'inline';
      }

      // Desktop Sticky Pill
      if (deskStickyPrice) deskStickyPrice.textContent = formatMoneyWithoutDecimals(discountedCents);
      if (deskStickyCompare) {
        deskStickyCompare.textContent = formatMoneyWithoutDecimals(originalCents);
        deskStickyCompare.style.display = 'inline';
      }
      
      // Update top green strip dynamically when deal is applied
      if (stickyDealStrip) {
        const unitDiscounted = Math.round(currentVariantPrice * (1 - (discountPercent / 100)));
        stickyDealStrip.innerHTML = 'Applied <strong>' + activeCode + '</strong> (' + discountPercent + '% Off) • ' + formatMoneyWithoutDecimals(unitDiscounted) + '/each';
      }
    } else {
      if (subtotalElem) subtotalElem.textContent = formatMoneyWithoutDecimals(originalCents);
      if (compareElem) compareElem.style.display = 'none';
      if (discountTag) discountTag.style.display = 'none';

      if (stickyPrice) stickyPrice.textContent = formatMoneyWithoutDecimals(currentVariantPrice);
      if (stickyCompare && currentVariantComparePrice > currentVariantPrice) {
        stickyCompare.textContent = formatMoneyWithoutDecimals(currentVariantComparePrice);
        stickyCompare.style.display = 'inline';
      } else if (stickyCompare) {
        stickyCompare.style.display = 'none';
      }
      if (stickyDisc && currentVariantDiscountPercent > 0) {
        stickyDisc.textContent = currentVariantDiscountPercent + '% Off';
        stickyDisc.style.display = 'inline';
      } else if (stickyDisc) {
        stickyDisc.style.display = 'none';
      }

      // Desktop Sticky Pill
      if (deskStickyPrice) deskStickyPrice.textContent = formatMoneyWithoutDecimals(originalCents);
      if (deskStickyCompare && currentVariantComparePrice > currentVariantPrice) {
        deskStickyCompare.textContent = formatMoneyWithoutDecimals(currentVariantComparePrice * qty);
        deskStickyCompare.style.display = 'inline';
      } else if (deskStickyCompare) {
        deskStickyCompare.style.display = 'none';
      }

      // Default prompt before deal is clicked
      if (stickyDealStrip) {
        if (isDealsEnabledOnProduct) {
          stickyDealStrip.innerHTML = 'Get at ' + formatMoneyWithoutDecimals(currentVariantPrice) + ' by using <strong>' + tierConfig.t1_code + '</strong>';
        } else if (currentVariantDiscountPercent > 0) {
          stickyDealStrip.innerHTML = '🔥 Special Sale Price: ' + formatMoneyWithoutDecimals(currentVariantPrice) + ' (Save ' + currentVariantDiscountPercent + '%)';
        } else {
          stickyDealStrip.innerHTML = '⚡ Best Price: ' + formatMoneyWithoutDecimals(currentVariantPrice);
        }
      }
    }

    // Highlight active card
    document.querySelectorAll('.boat-pdp-offer-card').forEach(c => c.classList.remove('active'));
    if (qty >= tierConfig.t3_qty) {
      document.getElementById('BoatDealCard-' + tierConfig.t3_qty)?.classList.add('active');
    } else if (qty >= tierConfig.t2_qty) {
      document.getElementById('BoatDealCard-' + tierConfig.t2_qty)?.classList.add('active');
    } else if (qty >= tierConfig.t1_qty) {
      document.getElementById('BoatDealCard-' + tierConfig.t1_qty)?.classList.add('active');
    }
  }

  // Click on Deal Card -> Auto-Set Quantity + Copy Coupon + Recalculate Subtotal
  function applyBoatDeal(qty, discount, code, cardElem) {
    const qtyInput = document.getElementById('BoatPdpQuantity');
    if (qtyInput) {
      qtyInput.value = qty;
    }

    window.activePdpDiscountCode = code;

    try {
      navigator.clipboard.writeText(code);
    } catch(e) {}

    const codeElem = cardElem.querySelector('.boat-pdp-offer-code');
    if (codeElem) {
      const originalHtml = codeElem.innerHTML;
      codeElem.innerHTML = '✓ ' + code + ' (Qty ' + qty + ')';
      setTimeout(() => {
        codeElem.innerHTML = 'Code: <strong>' + code + '</strong>';
      }, 1500);
    }

    updateBoatSubtotal();
  }

  // Quantity Stepper Handler
  function changePdpQty(delta) {
    const input = document.getElementById('BoatPdpQuantity');
    if (!input) return;
    let val = parseInt(input.value, 10) || 1;
    val = Math.max(1, val + delta);
    input.value = val;
    updateBoatSubtotal();
  }

  function handleOptionSelect(btn) {
    const optIndex = parseInt(btn.dataset.optionIndex, 10);
    const optValue = btn.dataset.optionValue;

    selectedOptions[optIndex] = optValue;

    // Update active class
    const parentGrid = btn.closest('.boat-pdp-swatches-grid');
    if (parentGrid) {
      parentGrid.querySelectorAll('.boat-pdp-opt-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    // Update option title label
    const labelElem = document.getElementById('BoatPdpOptVal-' + optIndex);
    if (labelElem) labelElem.textContent = optValue;

    // Find matching variant from master variantsData
    const matchedVariant = variantsData.find(v => {
      if (selectedOptions.length === 1) return v.option1 === selectedOptions[0];
      if (selectedOptions.length === 2) return v.option1 === selectedOptions[0] && v.option2 === selectedOptions[1];
      if (selectedOptions.length === 3) return v.option1 === selectedOptions[0] && v.option2 === selectedOptions[1] && v.option3 === selectedOptions[2];
      return false;
    });

    if (matchedVariant) {
      // Update hidden input
      const idInput = document.getElementById('BoatPdpSelectedVariantId');
      if (idInput) idInput.value = matchedVariant.id;

      // Update Price & Current Unit Price
      currentVariantPrice = matchedVariant.price;
      currentVariantComparePrice = matchedVariant.compare_at_price || 0;
      if (matchedVariant.compare_at_price > matchedVariant.price) {
        currentVariantDiscountPercent = Math.round(((matchedVariant.compare_at_price - matchedVariant.price) * 100) / matchedVariant.compare_at_price);
      } else {
        currentVariantDiscountPercent = 0;
      }

      const priceElem = document.getElementById('BoatPdpPrice');
      if (priceElem) priceElem.textContent = formatMoneyWithoutDecimals(matchedVariant.price);

      // Recalculate Subtotal & Sticky Bar
      updateBoatSubtotal();

      // Update Compare Price & Discount
      const compElem = document.getElementById('BoatPdpCompare');
      const discElem = document.getElementById('BoatPdpDiscount');
      if (matchedVariant.compare_at_price > matchedVariant.price) {
        const discPercent = Math.round(((matchedVariant.compare_at_price - matchedVariant.price) * 100) / matchedVariant.compare_at_price);
        if (compElem) {
          compElem.textContent = formatMoneyWithoutDecimals(matchedVariant.compare_at_price);
          compElem.style.display = 'inline';
        }
        if (discElem) {
          discElem.textContent = discPercent + '% Off';
          discElem.style.display = 'inline';
        }
      } else {
        if (compElem) compElem.style.display = 'none';
        if (discElem) discElem.style.display = 'none';
      }

      // Update Main Image if variant has image
      if (matchedVariant.featured_image) {
        const mainImg = document.getElementById('BoatPdpMainImage');
        if (mainImg) mainImg.src = matchedVariant.featured_image;
        const deskStickyImg = document.getElementById('BoatDesktopStickyImg');
        if (deskStickyImg) deskStickyImg.src = matchedVariant.featured_image;
      }

      // Update Buttons
      const atcBtn = document.getElementById('BoatPdpAtcBtn');
      const buyBtn = document.getElementById('BoatPdpBuyBtn');
      if (atcBtn) {
        atcBtn.disabled = !matchedVariant.available;
        atcBtn.innerHTML = matchedVariant.available ? '<span>Add to Cart</span>' : '<span>Sold Out</span>';
      }
      if (buyBtn) buyBtn.disabled = !matchedVariant.available;
    } else {
      // Combination unavailable
      const atcBtn = document.getElementById('BoatPdpAtcBtn');
      const buyBtn = document.getElementById('BoatPdpBuyBtn');
      if (atcBtn) {
        atcBtn.disabled = true;
        atcBtn.innerHTML = '<span>Unavailable</span>';
      }
      if (buyBtn) buyBtn.disabled = true;
    }
  }

  // Smooth Submit Handler supporting auto coupon session sync
  async function handleBoatPdpSubmit(event, form) {
    if (activeCouponCode) {
      try {
        fetch('/discount/' + encodeURIComponent(activeCouponCode));
      } catch(e) {}
    }
    handleBoatAddToCart(event, form);
  }

  // Direct Checkout for Buy Now Button with Active Coupon Applied
  async function buyNowBoatPdp(formId) {
    const variantId = document.getElementById('BoatPdpSelectedVariantId').value;
    if (!variantId) return;

    const qtyInput = document.getElementById('BoatPdpQuantity');
    const quantity = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;

    const buyBtn = document.getElementById('BoatPdpBuyBtn');
    if (buyBtn) {
      buyBtn.disabled = true;
      buyBtn.innerHTML = '<span>Proceeding to Checkout...</span>';
    }

    let checkoutUrl = '/checkout';
    if (activeCouponCode) {
      checkoutUrl += '?discount=' + encodeURIComponent(activeCouponCode);
    }

    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: quantity })
      });
      window.location.href = checkoutUrl;
    } catch(e) {
      window.location.href = checkoutUrl;
    }
  }

  // Global Delegated Click Listener to Ensure Cart Drawer (X) Close & Backdrop Always Works 100%
  document.addEventListener('click', function(e) {
    const closeBtn = e.target.closest('.theme-drawer__close-button, [on\\:click*="close"], .cart-drawer__close-button--empty');
    if (closeBtn && closeBtn.closest('#cart-drawer, .theme-drawer, cart-drawer-component')) {
      e.preventDefault();
      e.stopPropagation();
      const drawer = document.getElementById('cart-drawer');
      if (drawer) {
        if (typeof drawer.close === 'function') {
          drawer.close();
        }
        const dialog = drawer.querySelector('dialog');
        if (dialog && typeof dialog.close === 'function') {
          dialog.close();
        }
        drawer.removeAttribute('open');
      }
    }
  });

  // Switch PDP Content Tab on Click (Overview, Specs, FAQs, Reviews)
  function switchBoatTab(tabId, btnElem) {
    // 1. Update active class on pill buttons
    document.querySelectorAll('.boat-nav-pill').forEach(b => b.classList.remove('active'));
    if (btnElem) btnElem.classList.add('active');

    // 2. Hide all tab sections, show selected one
    document.querySelectorAll('.boat-tab-section').forEach(sec => sec.classList.remove('active'));
    const targetSection = document.getElementById('boat-tab-' + tabId);
    if (targetSection) {
      targetSection.classList.add('active');
    }

    // 3. Smooth scroll to tabs area if user was scrolled below it
    const wrapper = document.getElementById('BoatPdpNavStickyWrapper');
    if (wrapper) {
      const rect = wrapper.getBoundingClientRect();
      if (rect.top < 0) {
        window.scrollTo({
          top: window.pageYOffset + rect.top - 80,
          behavior: 'smooth'
        });
      }
    }
  }

  // Toggle FAQ Accordion Item
  function toggleBoatFaq(item) {
    const isActive = item.classList.contains('active');
    // Close other FAQs
    document.querySelectorAll('.boat-faq-item').forEach(f => f.classList.remove('active'));
    if (!isActive) {
      item.classList.add('active');
    }
  }

  // Toggle Write a Review Form
  function toggleBoatReviewForm() {
    const formWrapper = document.getElementById('BoatReviewFormWrapper');
    if (!formWrapper) return;
    if (formWrapper.style.display === 'none' || formWrapper.style.display === '') {
      formWrapper.style.display = 'block';
      formWrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      formWrapper.style.display = 'none';
    }
  }

  // Set Star Rating on Review Form
  function setBoatFormRating(stars, clickedStar) {
    const ratingInput = document.getElementById('BoatFormRatingVal');
    if (ratingInput) ratingInput.value = stars;
    const allStars = document.querySelectorAll('.boat-star-option');
    allStars.forEach((star, idx) => {
      if (idx < stars) {
        star.classList.add('active');
      } else {
        star.classList.remove('active');
      }
    });
  }

  // Handle Review Submission
  function handleBoatReviewSubmit(e, form) {
    e.preventDefault();
    const successMsg = document.getElementById('BoatReviewSuccessMsg');
    if (successMsg) {
      successMsg.style.display = 'block';
      form.reset();
      setTimeout(() => {
        toggleBoatReviewForm();
        successMsg.style.display = 'none';
      }, 3000);
    }
  }

  // Desktop Floating Sticky Bar Add to Cart Action
  function triggerBoatDesktopAtc() {
    const atc = document.getElementById('BoatPdpAtcBtn');
    if (atc) {
      atc.click();
    } else {
      const form = document.getElementById('BoatProductPageForm-{{ product.id }}');
      if (form) form.submit();
    }
  }

  // Desktop Floating Sticky Pill Bar Scroll Trigger Observer
  function initBoatDesktopSticky() {
    const desktopSticky = document.getElementById('BoatPdpDesktopStickyBar');
    if (!desktopSticky) return;

    function checkStickyVisibility() {
      // Only show on desktop screens (> 768px)
      if (window.innerWidth <= 768) {
        desktopSticky.classList.remove('visible');
        return;
      }

      const atcBtn = document.getElementById('BoatPdpAtcBtn') || document.querySelector('.boat-pdp-cta-group');
      const scrollY = window.pageYOffset || window.scrollY || document.documentElement.scrollTop || (document.body ? document.body.scrollTop : 0) || 0;

      if (!atcBtn) {
        if (scrollY > 150) {
          desktopSticky.classList.add('visible');
        } else {
          desktopSticky.classList.remove('visible');
        }
        return;
      }

      const rect = atcBtn.getBoundingClientRect();
      // Show when user scrolls past the top add to cart button or scrolls down >= 250px
      if (rect.bottom <= 200 || scrollY > 250) {
        desktopSticky.classList.add('visible');
      } else {
        desktopSticky.classList.remove('visible');
      }
    }

    window.addEventListener('scroll', checkStickyVisibility, { passive: true });
    window.addEventListener('touchmove', checkStickyVisibility, { passive: true });
    document.addEventListener('scroll', checkStickyVisibility, { passive: true });
    window.addEventListener('resize', checkStickyVisibility, { passive: true });
    
    // Initial check
    checkStickyVisibility();
    setTimeout(checkStickyVisibility, 150);
    setTimeout(checkStickyVisibility, 500);
    setTimeout(checkStickyVisibility, 1200);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBoatDesktopSticky);
  } else {
    initBoatDesktopSticky();
  }
  document.addEventListener('shopify:section:load', initBoatDesktopSticky);
  document.addEventListener('shopify:section:select', initBoatDesktopSticky);
  document.addEventListener('shopify:section:reorder', initBoatDesktopSticky);

  // Initial subtotal calculation on page load
  document.addEventListener('DOMContentLoaded', updateBoatSubtotal);
</script>

