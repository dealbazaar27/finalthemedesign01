  @keyframes popInBadge {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  /* DEAL Section */
  .boat-pdp-offers-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 10px;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-pdp-card-title {
    font-size: 0.92rem;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.2px;
  }

  .boat-pdp-offers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-pdp-offer-card {
    background: #e6fcf5;
    border: 1.5px solid #a3e635;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-align: center;
