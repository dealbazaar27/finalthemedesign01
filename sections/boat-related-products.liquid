{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign products_limit = section.settings.products_to_show | default: 10

  assign target_collection = section.settings.collection
  if target_collection == blank
    if product != blank and product.collections.size > 0
      assign target_collection = product.collections.first
    else
      assign target_collection = collections['all']
    endif
  endif

  assign slider_id = 'BoatRelatedSlider-' | append: section.id
%}

<div class="boat-related-section" id="BoatRelatedSection-{{ section.id }}">
  <div class="boat-related-container">
    
    {% comment %} Section Header with Left/Right Arrow Controls {% endcomment %}
    {% if heading != blank or subheading != blank %}
      <div class="boat-related-header">
        <div class="boat-related-header-left">
          {% if subheading != blank %}
            <span class="boat-related-subheading">{{ subheading }}</span>
          {% endif %}
          {% if heading != blank %}
            <h2 class="boat-related-title">{{ heading }}</h2>
          {% endif %}
        </div>
    {% else %}
      <div class="boat-related-header boat-related-header--no-title">
        <div class="boat-related-header-left"></div>
    {% endif %}

      <div class="boat-related-header-actions">
        {% if section.settings.show_view_all and target_collection != blank %}
          <a href="{{ target_collection.url }}" class="boat-related-view-all">
            <span>View All</span>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        {% endif %}

        <div class="boat-slider-controls">
          <button type="button" class="boat-slider-arrow boat-slider-arrow--prev" onclick="slideBoatRelated('{{ slider_id }}', -1)" aria-label="Previous Products">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" class="boat-slider-arrow boat-slider-arrow--next" onclick="slideBoatRelated('{{ slider_id }}', 1)" aria-label="Next Products">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    {% comment %} Full-Screen Slider Track {% endcomment %}
    <div class="boat-related-slider-wrapper">
      <div class="boat-related-slider-track" id="{{ slider_id }}">
        {% liquid
          assign shown_count = 0
          for prod in target_collection.products
            if product != blank and prod.id == product.id
              continue
            endif
            if shown_count >= products_limit
              break
            endif
            
            echo '<div class="boat-related-slide">'
            render 'boat-product-card-item', product: prod
            echo '</div>'
            assign shown_count = shown_count | plus: 1
          endfor

          # Fallback if no collection products
          if shown_count == 0
            for prod in collections['all'].products limit: products_limit
              if product != blank and prod.id == product.id
                continue
              endif
              echo '<div class="boat-related-slide">'
              render 'boat-product-card-item', product: prod
              echo '</div>'
              assign shown_count = shown_count | plus: 1
            endfor
          endif
        %}
      </div>
    </div>

  </div>
</div>

{% render 'boat-product-card-script' %}

<script>
  function slideBoatRelated(sliderId, direction) {
    const track = document.getElementById(sliderId);
    if (!track) return;
    const slide = track.querySelector('.boat-related-slide');
    const scrollAmount = slide ? (slide.offsetWidth + 16) * 2 : 320;
    track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
  }

  // Mouse Drag to Scroll on Slider Track
  (function() {
    const track = document.getElementById('{{ slider_id }}');
    if (!track) return;
    let isDown = false;
    let startX;
    let scrollLeft;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      track.classList.add('dragging');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => {
      isDown = false;
      track.classList.remove('dragging');
    });

    track.addEventListener('mouseup', () => {
      isDown = false;
      track.classList.remove('dragging');
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      track.scrollLeft = scrollLeft - walk;
    });
  })();
</script>

<style>
  .boat-related-section {
    width: 100%;
    padding: 44px 0 52px 0;
    background: #ffffff;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
    border-top: 1px solid #f1f5f9;
  }

  .boat-related-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .boat-related-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 22px;
    gap: 16px;
  }

  .boat-related-subheading {
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #00b853;
    margin-bottom: 4px;
  }

  .boat-related-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.4px;
    margin: 0;
    line-height: 1.2;
  }

  .boat-related-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .boat-related-view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    font-weight: 800;
    color: #0f172a;
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 9999px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .boat-related-view-all:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .boat-slider-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .boat-slider-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .boat-slider-arrow:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .boat-related-slider-wrapper {
    width: 100%;
    position: relative;
  }

  .boat-related-slider-track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 6px 2px 16px 2px;
    cursor: grab;
    user-select: none;
  }

  .boat-related-slider-track.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .boat-related-slider-track::-webkit-scrollbar {
    display: none;
  }

  /* Responsive Slider Card Widths on All Screens */
  .boat-related-slide {
    flex: 0 0 calc((100% - (18px * 3)) / 4);
    max-width: calc((100% - (18px * 3)) / 4);
    min-width: 250px;
    scroll-snap-align: start;
    box-sizing: border-box;
  }

  @media screen and (max-width: 1200px) {
    .boat-related-slide {
      flex: 0 0 calc((100% - (16px * 2)) / 3);
      max-width: calc((100% - (16px * 2)) / 3);
      min-width: 240px;
    }
  }

  @media screen and (max-width: 768px) {
    .boat-related-section {
      padding: 30px 0 36px 0;
    }

    .boat-related-container {
      padding: 0 14px;
    }

    .boat-related-title {
      font-size: 1.25rem;
    }

    .boat-related-slider-track {
      gap: 12px;
      padding-bottom: 8px;
    }

    .boat-related-slide {
      flex: 0 0 215px;
      max-width: 215px;
      min-width: 215px;
    }

    .boat-slider-arrow {
      width: 32px;
      height: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "boAt Related Products",
  "tag": "section",
  "class": "boat-related-products-section",
  "settings": [
        {
      "type": "header",
      "content": "🎨 Colors & Typography Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Text Color",
      "default": "#64748b"
    },
    {
      "type": "color",
      "id": "view_all_color",
      "label": "View All Link Color",
      "default": "#0f172a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Related Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Explore products matching your choice"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (Leave empty for automatic recommendations)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "boAt Related Products"
    }
  ]
}
{% endschema %}
